  "applications": [
    {
      "name": "google",
      "tags": [
        "google@cn"
      ],
      "split": true,
      "proxy_tags": [
        "google@!cn"
      ]
    },
    {
      "name": "facebook",
      "tags": [
        "meta"
      ]
    },
    {
      "name": "netflix",
      "tags": [
        "netflix"
      ]
    },
    {
      "name": "disney",
      "tags": [
        "disney"
      ]
    },
    {
      "name": "youtube",
      "tags": [
        "youtube"
      ]
    },
    {
      "name": "telegram",
      "tags": [
        "telegram"
      ]
    },
    {
      "name": "steam",
      "tags": [
        "steam@cn"
      ],
      "split": true,
      "proxy_tags": [
        "steam@!cn"
      ]
    },
    {
      "name": "x",
      "tags": [
        "twitter"
      ]
    },
    {
      "name": "spotify",
      "tags": [
        "spotify"
      ]
    },
    {
      "name": "github",
      "tags": [
        "github"
      ]
    },
    {
      "name": "ai",
      "tags": [
        "category-ai-!cn",
        "apple-intelligence",
        "github-copilot"
      ],
      "exclude_tags": [
        "category-ai-cn"
      ]
    },
    {
      "name": "apple",
      "tags": [
        "apple@cn"
      ],
      "split": true,
      "proxy_tags": [
        "apple@!cn",
        "apple-intelligence",
        "apple-tvplus"
      ]
    },
    {
      "name": "microsoft",
      "tags": [
        "microsoft@cn"
      ],
      "split": true,
      "proxy_tags": [
        "microsoft@!cn",
        "github-copilot"
      ]
    }
  ],
  "surge_output": {
    "apple": "split",
    "microsoft": "split",
    "google": "split",
    "steam": "split",
    "github": "combined",
    "spotify": "combined",
    "facebook": "combined",
    "netflix": "combined",
    "disney": "combined",
    "youtube": "combined",
    "telegram": "combined",
    "x": "combined",
    "ai": "combined",
    "media": "combined"
  },
  "default_policies": {
    "media_cn": "DIRECT"
  },
  "collections": {
    "media": [
      "category-companies",
      "category-entertainment",
      "category-communication",
      "category-dev",
      "category-ai-!cn",
      "category-social-media-!cn"
