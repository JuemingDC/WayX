{
  "version": 2,
  "settings": {
    "state_file": ".github/monitor/state.json",
    "mirror_root": ".github/monitor/upstream",
    "runtime_root": ".github/monitor/.runtime",
    "timeout_seconds": 25
  },
  "sources": [
    {
      "id": "kelee-plugin-directory",
      "name": "可莉去广告与依赖插件目录",
      "kind": "http",
      "platform": "Loon",
      "url": "https://hub.kelee.one/list.json",
      "save_as": "Kelee/list.json",
      "normalize": "raw",
      "category": "插件发现",
      "cached_feed": ".github/monitor/.runtime/kelee-feed.json"
    },
    {
      "id": "surge-official-llms",
      "name": "Surge 官方 llms.txt",
      "kind": "http",
      "platform": "Surge",
      "url": "https://nssurge.com/llms.txt",
      "save_as": "Surge/llms.txt",
      "normalize": "raw",
      "category": "官方文档"
    },
    {
      "id": "loon-rewrite-v2",
      "name": "Loon Rewrite 新语法官方文档",
      "kind": "http",
      "platform": "Loon",
      "url": "https://nsloon.app/docs/Rewrite/rewrite_v2/",
      "save_as": "Loon/rewrite_v2.txt",
      "normalize": "html_text",
      "category": "官方文档"
    },
    {
      "id": "quantumultx-official",
      "name": "Quantumult X 官方仓库",
      "kind": "github_repo",
      "platform": "Quantumult X",
      "repo": "crossutility/Quantumult-X",
      "ref": "master",
      "save_as": "QuantumultX/official",
      "sync_changed_files": true,
      "include_globs": [
        "*.conf",
        "*.snippet",
        "*.js",
        "*.md",
        "*.json"
      ],
      "category": "官方示例与语法"
    },
    {
      "id": "quantumultx-parser",
      "name": "Quantumult X 资源解析器仓库",
      "kind": "github_repo",
      "platform": "Quantumult X",
      "repo": "KOP-XIAO/QuantumultX",
      "ref": "master",
      "save_as": "QuantumultX/parser",
      "sync_changed_files": true,
      "include_globs": [
        "*.js",
        "*.md",
        "*.conf",
        "*.snippet"
      ],
      "category": "资源解析器"
    },
    {
      "id": "icons-lige47",
      "name": "lige47 应用图标集",
      "kind": "http",
      "url": "https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/ligeicon.json",
      "save_as": "Icons/lige47.json",
      "normalize": "raw",
      "category": "应用图标",
      "cached_feed": ".github/monitor/.runtime/icon-feeds/lige47.json"
    },
    {
      "id": "icons-fmz200",
      "name": "fmz200 应用图标集",
      "kind": "http",
      "url": "https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/icons-all.json",
      "save_as": "Icons/fmz200.json",
      "normalize": "raw",
      "category": "应用图标",
      "cached_feed": ".github/monitor/.runtime/icon-feeds/fmz200.json"
    },
    {
      "id": "icons-qure-color",
      "name": "qure-color 应用图标集",
      "kind": "http",
      "url": "https://raw.githubusercontent.com/Koolson/Qure/master/Other/QureColor.json",
      "save_as": "Icons/qure-color.json",
      "normalize": "raw",
      "category": "应用图标",
      "cached_feed": ".github/monitor/.runtime/icon-feeds/qure-color.json"
    }
  ]
}
