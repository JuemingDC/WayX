{
  "version": 1,
  "scope": "Catalog-observed Loon Legacy Rewrite / Script syntax shapes",
  "legacyRewrite": {
    "actionKinds": [
      "json",
      "mock",
      "reject"
    ],
    "actionShapes": [
      "json:response:del",
      "json:response:jq",
      "json:response:replace",
      "mock:response:inline",
      "reject:dict",
      "reject:generic",
      "reject:image"
    ],
    "mockOptionSets": [
      "data|data-type|status-code"
    ]
  },
  "legacyScript": {
    "phases": [
      "response"
    ],
    "optionNames": [
      "argument",
      "binary-body-mode",
      "enable",
      "requires-body",
      "script-path",
      "tag",
      "timeout"
    ],
    "optionShapes": [
      "argument:raw-string",
      "binary-body-mode:boolean",
      "enable:variable",
      "requires-body:boolean",
      "script-path:raw-string",
      "tag:raw-string",
      "timeout:number"
    ],
    "optionSets": [
      "argument|binary-body-mode|requires-body|script-path|tag|timeout",
      "enable|requires-body|script-path|tag|timeout",
      "requires-body|script-path|tag"
    ]
  }
}
