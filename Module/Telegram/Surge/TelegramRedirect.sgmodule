#!name=Telegram 第三方客户端重定向
#!desc=t.me 链接重定向至 Telegram / Swiftgram / Turrit / iMe / Nicegram / Lingogram / Nagram
# Author: PandaX & chance
# Category: Redirect
#!arguments=CLIENT:Telegram
#!arguments-desc=CLIENT: 可选 Telegram, Swiftgram, Turrit, iMe, Nicegram, Lingogram, Nagram
# Updated: 2026-09-26

[Script]
Telegram 第三方客户端重定向 = type=http-request, pattern=^https?:\/\/t\.me\/.+, script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Telegram/Surge/TelegramRedirect.js, timeout=5, argument=CLIENT={{{CLIENT}}}

[MITM]
hostname = %APPEND% t.me
