[Rule]
# Name: unblockurlinwechat
# Updated: 2026-11-01 21:23:26 +08:00
# Copied by: chance
# Source Authors: 墨鱼 / ddgksf2013
# Category: Module
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/Function/UnblockURLinWeChat.conf
#跳过中间界面，支付宝链接、被封禁链接进行通知弹窗跳转，在微信中用快照显示被封禁的链接（可选），在微信中进行强制重定向（可选），群聊 / 扫码均可使用，可选项可在脚本 2、3 行更改，也可在 BoxJs 中更改
#Author：zZPiglet，原重写地址：https://raw.githubusercontent.com/zZPiglet/Task/refs/heads/master/UnblockURLinWeChat.conf

[Script]
ddgksf2013_unblockurlinwechat_1 = type=http-response,pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/unblockurlinwechat/weixin110.js,requires-body=true

[MITM]
hostname = %APPEND% weixin110.qq.com, security.wechat.com
