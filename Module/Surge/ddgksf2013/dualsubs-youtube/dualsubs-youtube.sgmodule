[Map Local]
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ddgksf2013_dualsubs-youtube_1 = type=http-request,pattern=^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/dualsubs-youtube/api.js,requires-body=false
