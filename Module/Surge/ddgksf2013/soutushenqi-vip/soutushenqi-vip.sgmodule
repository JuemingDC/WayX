[Map Local]
^http?:\/\/wallpaper\.soutushenqi\.com\/v\d\/home\/dialog data-type=text data="" status-code=200

[Body Rewrite]
http-request ^http?:\/\/wallpaper\.soutushenqi\.com\/v\d\/config config_key=stsq_ios_home_vipI config_key=

[Script]
ddgksf2013_soutushenqi-vip_1 = type=http-response,pattern=^http?:\/\/wallpaper\.soutushenqi\.com\/v\d\/config,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/soutushenqi-vip/soutushenqi.vip.js,requires-body=true
ddgksf2013_soutushenqi-vip_2 = type=http-response,pattern=^http?:\/\/wallpaper\.soutushenqi\.com\/api\/v\d\/account,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/soutushenqi-vip/soutushenqi.vip.js,requires-body=true

[MITM]
hostname = %APPEND% wallpaper.soutushenqi.com
