[Rule]
# Name: Emby增强[墨鱼整理版]
# Updated: 2026-11-01 21:23:26 +08:00
# Copied by: chance
# Source Authors: 墨鱼 / ddgksf2013
# Category: Module
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/Function/EmbyPlugin.conf
// ==UserScript==
// @ScriptName        Emby增强[墨鱼整理版]
// @Author            @renzhipengBot 原创，@AppleArcade 魔改
// @Function          Emby官方客户端内调用外部播放器，该功能需要自行添加Emby服域名的MITM
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2024-01-24
// @Suitable          自行观看“# > ”注释内容
// @Version           V1.0.2
// @ScriptURL         https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/Function/EmbyPlugin.conf
// ==/UserScript==
# > 播放解锁
# > 添加外部播放器连接
# > 打开外部播放器
# > 资源路径伪静态
# > 下载文件重命名
# > 解决QX抓取某些公益服该请求乱码问题
# Modified: 2026-11-01 (chance). Repair missing CRLF capture references; replace only an existing Accept-Encoding field.
# Source declaration: \/Users\/\w{32}\/Items\/\d+\? url request-header (\r\n)Accept-Encoding:.+ request-header $Accept-Encoding: gzip, deflate, br

[Header Rewrite]
http-request \/Users\/\w{32}\/Items\/\d+\? header-replace Accept-Encoding gzip, deflate, br

[Script]
ddgksf2013_embyplugin_1 = type=http-response,pattern=^https?:\/\/mb3admin\.com\/admin\/service\/registration\/validateDevice,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/embyplugin/unlock.js,requires-body=true
ddgksf2013_embyplugin_2 = type=http-response,pattern=\/[Uu]sers\/\w{32}\/[Ii]tems\/\d+\??,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/embyplugin/emby-plugin.js,requires-body=true
ddgksf2013_embyplugin_3 = type=http-request,pattern=\/plugin\/scheme,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/embyplugin/emby-plugin.js,requires-body=false
ddgksf2013_embyplugin_4 = type=http-request,pattern=(\/[Vv]ideos\/\d+\/stream\/.+\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/\d+\/.+\?.+&filename),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/embyplugin/emby-plugin.js,requires-body=false
ddgksf2013_embyplugin_5 = type=http-response,pattern=(\/[Vv]ideos\/\d+\/stream\?.+&filename)|(\/[Vv]ideos\/\d+\/\w{32}\/[Ss]ubtitles\/.+&filename),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Surge/ddgksf2013/embyplugin/download_file_rename.js,requires-body=false

[MITM]
hostname = %APPEND% mb3admin.com, *.emby.wtf, *.plusmedia.site
