// ==/UserScript==

[Body Rewrite]
http-request ^https?:\/\/testflight\.apple\.com\/v2\/accounts\/.*\/apps\/\d*/builds/\d*/install "storefrontId\" : \".*\"" "storefrontId\" : \"143441-1,29\""

[MITM]
hostname = %APPEND% testflight.apple.com
