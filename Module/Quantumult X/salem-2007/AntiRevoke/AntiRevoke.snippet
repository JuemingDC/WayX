# Name: Apple证书屏蔽验证
# Description: 按源规则屏蔽证书在线状态检查
# Converted by: chance
# Target: Quantumult X
# Category: 工具 / 证书状态检查屏蔽
# Converted: 2026-10-30 (Asia/Shanghai)
# Modified: 2026-10-30 (chance). 保留源 17 条精确域名拒绝规则、原注释和 3 个 MITM 主机；仅转换客户端格式。
# Source: https://raw.githubusercontent.com/salem-2007/apple-cert-block/main/AntiRevoke.plugin
# Note: 屏蔽在线状态检查不延长证书有效期，也不保证已吊销应用可用。
# Note: 源包含第三方 CA 的 OCSP/CRL 域名，作用范围不限于 Apple 应用签名。
# Upstream #!name=Apple证书屏蔽验证
# Upstream #!desc=精准屏蔽 Apple p12证书验证，让已过期证书能够继续使用
# Upstream #!author=Salem
# Upstream #!homepage=https://github.com/salem-2007/apple-cert-block
# Upstream #!openUrl=https://t.me/LKm0907
# Upstream #!icon=https://cdn.jsdelivr.net/gh/salem-2007/apple-cert-block@main/icon.png
# Upstream #!tag=Apple,Certificate,AntiRevoke
# Upstream #!loon_version=3.2.0
# Upstream #!system=iOS,iPadOS
# Upstream #!update-url=https://raw.githubusercontent.com/salem-2007/apple-cert-block/main/AntiRevoke.plugin

# =========================================
# AntiRevoke - Core
# Only blocks certificate verification
# =========================================

# [filter_local]

# Apple OCSP
host, ocsp.apple.com, reject
host, ocsp2.apple.com, reject

# Apple Validation
host, valid.apple.com, reject
host, ppq.apple.com, reject
host, ppq-ext.v.aaplimg.com, reject

# Apple CRL
host, crl.apple.com, reject
host, certs.apple.com, reject

# DigiCert
host, ocsp.digicert.com, reject
host, ocsp.digicert.cn, reject
host, crl3.digicert.com, reject
host, crl4.digicert.com, reject

# Entrust
host, ocsp.entrust.net, reject
host, crl.entrust.net, reject

# Sectigo / USERTrust
host, ocsp.sectigo.com, reject
host, crl.sectigo.com, reject
host, ocsp.usertrust.com, reject
host, crl.usertrust.com, reject

# [rewrite_local]

# [mitm]
hostname = ocsp.apple.com, ocsp2.apple.com, valid.apple.com
