# [mitm]
hostname = www.google.*,

# [rewrite_local]
^https?:\/\/www\.google\..*\/search url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Quantumult%20X/ddgksf2013/endlessgoogle/endlessgoogle.js
