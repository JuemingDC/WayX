#[rewrite_local]
^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/Module/Quantumult%20X/ddgksf2013/dualsubs-youtube/api.js
# [WayX] SOURCE INVALID: QX echo-response requires a local Data-relative resource; upstream remote resource is not supported by the official sample
# Source declaration: ^https:\/\/dualsubs\.github\.io\/api\/YouTube(?:\?.*)?$ url echo-response application/json\r\nX-PreferencePanes-Version: 1.6.0 echo-response https://github.com/DualSubs/YouTube/releases/download/v1.6.0/DualSubs.YouTube.PreferencePanes.json
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$ url reject-dict

#[Script]
# YouTube
