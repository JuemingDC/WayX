#!name=可莉插件中心转 Surge
#!desc=将 hub.kelee.one / pluginhub.kelee.one 的 Loon 插件导入链接转换为 Surge 模块安装，并交由 ScriptHub 转换
#!author=chance
#!category=工具
#!date=2026-06-13 22:00

[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Body Rewrite]
# 可莉插件中心：Loon 插件链接 → ScriptHub 转换 → Surge 安装模块
http-response https://(hub|pluginhub)\.kelee\.one/list\.json "loon://import\?plugin=(https://kelee\.one/Tool/Loon/Lpx/(.+?)\.lpx)" "surge:///install-module?url=http://script.hub/file/_start_/$1/_end_/$2.sgmodule%3Ftype%3Dloon-plugin%26target%3Dsurge-module%26del%3Dtrue%26jqEnabled%3Dtrue%26pm%3D.%26sni%3D."

[Header Rewrite]
# 清理缓存，避免 list.json 不刷新导致 Body Rewrite 不生效
http-request https://(hub|pluginhub)\.kelee\.one/list\.json header-del if-none-match
http-request https://(hub|pluginhub)\.kelee\.one/list\.json header-del if-modified-since

[Script]
# 内置 ScriptHub 转换能力，不再要求额外安装 ScriptHub 模块
Script Hub: 前端 = type=http-request, pattern=^https?:\/\/script\.hub\/($|edit\/|reload), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js, timeout=300
Script Hub: 重写转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300

[MITM]
hostname = %APPEND% hub.kelee.one, pluginhub.kelee.one, script.hub, *.script.hub