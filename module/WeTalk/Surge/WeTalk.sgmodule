[Script]
WeTalk获取账号 = type=http-request,pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/JuemingDC/Surge/refs/heads/main/JavaScript/Wetalk/Wetalk_capture.js,requires-body=false,timeout=30
WeTalk签到 = type=cron,cronexp="20 8,20 * * *",script-path=https://raw.githubusercontent.com/JuemingDC/Surge/refs/heads/main/JavaScript/Wetalk/Wetalk_task.js,timeout=120

[MITM]
hostname = %APPEND% api.wetalkapp.com
