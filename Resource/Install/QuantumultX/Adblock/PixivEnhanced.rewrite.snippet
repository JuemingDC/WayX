# 1. 劫持 Pixiv App 内「帮助中心」与「服务条款」，一键直达增强设置中心
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ url 302 https://app-api.pixiv.net/settings/Enhanced
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ url 302 https://app-api.pixiv.net/settings/Enhanced

{# 2. 原生级增强设置中心 (0ms 离线瞬时秒开，对标 Pix-Scripting 与 iOS 原生视觉规范) #} ^https:\/\/app-api\.pixiv\.net\/settings\/Enhanced(?:\?[^#]*)?$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/PixivEnhanced/mock_file_ddaadb0277.js
# Pixiv.Enhanced.SettingsAPI
