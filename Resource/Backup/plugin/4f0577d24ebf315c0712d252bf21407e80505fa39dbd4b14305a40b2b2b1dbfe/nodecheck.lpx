[Script]
generic then script("https://rucu6.pages.dev/Scripts/general/node-check.js") with tag="节点阻断查询", img_url="waveform.path.ecg"
generic then script("https://rucu6.pages.dev/Scripts/general/network-in-out-query.js") with tag="入口落地查询", img_url="globe.asia.australia.system"
generic then script("https://rucu6.pages.dev/Scripts/general/location-detection.js") with tag="地理位置查询", img_url="location.circle.system"
generic then script("https://rucu6.pages.dev/Scripts/general/node-unlock-detection.js") with tag="节点解锁查询", img_url="play.circle.system"
