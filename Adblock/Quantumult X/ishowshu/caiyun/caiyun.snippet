# Upstream name = 彩云天气Pro
# Upstream desc = 简单屏蔽一些广告
# Upstream author = 树先生

# [filter_local]
host, abyss.cyapi.cn, reject
host, ad.cyapi.cn, reject

# 移除彩云广告
# [rewrite_local]
^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/features url reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) url reject-dict

^https:\/\/api\.caiyunapp\.com\/v1\/activity\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/ishowshu/caiyun/caiyun.js
^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/ishowshu/caiyun/caiyun.js
^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/ishowshu/caiyun/caiyun.js

# [mitm]
hostname = wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn
