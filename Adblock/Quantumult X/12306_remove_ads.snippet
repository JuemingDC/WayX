# [filter_local]
host, ad.12306.cn, direct

# [rewrite_local]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ url jsonjq-response-body 'if type == "object" then del(.["materialsList"]) else . end | if type == "object" then del(.["advertParam"]) else . end'

# 移除12306应用内广告
^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$ url script-request-header https://kelee.one/Resource/JavaScript/12306/12306_remove_ads.js

# [mitm]
hostname = ad.12306.cn, mobile.12306.cn
