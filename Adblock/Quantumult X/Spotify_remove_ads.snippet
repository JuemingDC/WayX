^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service) url script-response-body https://kelee.one/Resource/JavaScript/Spotify/Spotify_remove_ads.js

