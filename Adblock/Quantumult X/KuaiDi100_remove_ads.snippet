# [rewrite_local]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$ url jsonjq-response-body 'if type == "object" then del(.["adsplash"]) else . end | if type == "object" then del(.["adIsConsumable"]) else . end | if type == "object" then del(.["adProductId"]) else . end | if type == "object" then del(.["nologin_tips"]) else . end | if type == "object" then del(.["index_banner"]) else . end | if type == "object" then del(.["me_banner"]) else . end | if type == "object" then del(.["index_banner_shadow"]) else . end | if type == "object" then del(.["adshongbao"]) else . end | if type == "object" then del(.["adsapp_homepage_ticket_pop"]) else . end | if type == "object" then del(.["adsoptimizationsend"]) else . end | if type == "object" then del(.["adsapp_activity_ad_array"]) else . end | if type == "object" then del(.["adbanner"]) else . end | if type == "object" then del(.["adposition"]) else . end | if type == "object" then del(.["adShowAgainTime"]) else . end'

^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox url jsonjq-response-body 'del(.data.secondMenuList)'

^https?:\/\/p\.kuaidi100\.com\/advertisement\/ url reject-dict
^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\? url reject-dict
^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox url reject-dict

# [mitm]
hostname = p.kuaidi100.com
