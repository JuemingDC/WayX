# Name: B站gRPC数据包净化
# Updated: 2026-11-01 21:23:24 +08:00
# Copied by: chance
# Source Authors: 怎么肥事
# Category: Adblock
# Managed by: WayX Native QX

# Source: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/bili_view_ad_rewrite.snippet
# Upstream name = B站gRPC数据包净化
# Upstream author = 怎么肥事
# Upstream update = 2026-05-14
#   1. 相关推荐列表中的广告卡片（游戏推广等）
#   2. 视频详情页底部的广告控制模块
#   3. 搜索框预填充的推荐搜索词
#   4. 热门页面的UP主推荐关注卡片
#   5. 关注页面的"你可能感兴趣的UP主"卡片
#   6. 广告转化追踪请求
#   7. 广告数据上报
#   8. 番剧/影视播放页底部"超大会员限时秒杀 一份价格两份权益"会员推广

# [rewrite_local]
^https:\/\/app\.bilibili\.com\/bilibili\.app\.viewunite\.v1\.View\/View$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-7dd528f27c32/bili_view_ad.js
^https:\/\/app\.bilibili\.com\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-7dd528f27c32/bili_view_ad.js
^https:\/\/app\.bilibili\.com\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-7dd528f27c32/bili_view_ad.js
^https:\/\/app\.bilibili\.com\/bilibili\.app\.show\.v1\.Popular\/Index$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-7dd528f27c32/bili_view_ad.js
^https:\/\/app\.bilibili\.com\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-7dd528f27c32/bili_view_ad.js
^https:\/\/cm\.bilibili\.com\/cm\/api\/(conversion|fees)\/ url reject-dict
^https:\/\/dataflow\.biliapi\.com\/log\/pbmobile\/ url reject-200
^https:\/\/api-pt\.chuangyuejoy\.com\/ad\/ url reject-dict
# Source declaration: ^https?:\/\/api\.bilibili\.com\/x\/vip\/window\/list\? url jsonjq-response-body .data.list = []
^https?:\/\/api\.bilibili\.com\/x\/vip\/window\/list\? url jsonjq-response-body '.data.list = []'
# Source declaration: ^https?:\/\/api\.bilibili\.com\/x\/vip\/web\/vip_center\/(v2|modules) url jsonjq-response-body .data.benefits = [] | .data.welfare = null | .data.free_welfare = null | .data.draw_cards_welfare = null | .data.draw_cards_welfare_v2 = null
^https?:\/\/api\.bilibili\.com\/x\/vip\/web\/vip_center\/(v2|modules) url jsonjq-response-body '.data.benefits = [] | .data.welfare = null | .data.free_welfare = null | .data.draw_cards_welfare = null | .data.draw_cards_welfare_v2 = null'

# [mitm]
hostname = *bili*,api-pt.chuangyuejoy.com
