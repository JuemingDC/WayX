# Name: Github
# Updated: 2026-10-25 18:04:02 +08:00
# Merged by: chance
# Source Authors: 树先生
# Category: app
# Managed by: WayX Native QX

# [rewrite_local]
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/github.snippet
# Upstream name = Github
# Upstream desc = raw文件拉取
# Upstream author = 树先生

^https:\/\/(raw|gist)\.githubusercontent\.com\/ url request-header (\r\n)Accept-Language:.+(\r\n) request-header $1Accept-Language: en-us$2
^https:\/\/github\.com\/ url request-header (\r\n)Accept-Language:.+(\r\n) request-header $1Accept-Language: en-us$2

# [mitm]

# Upstream hostname = raw.githubusercontent.com, gist.githubusercontent.com, github.com
hostname = raw.githubusercontent.com, gist.githubusercontent.com, github.com
