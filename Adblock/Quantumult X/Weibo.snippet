# Converted: 2026-10-04 17:52:47 +08:00
# Converted by: chance
# Category: 去广告
# Source: https://rucu6.pages.dev/Plugins/weibo.lpx
# Target: Quantumult X

# [filter_local]
{# 请求放行 #} host-suffix, uve.weibo.com, direct

# 请求拦截
# 微博开屏广告
host-suffix, alitui.weibo.com, reject
host-suffix, beacon.sina.com.cn, reject
host-suffix, biz.weibo.com, reject
host, dns.weibo.cn, reject
host, huodong.weibo.cn, reject
host, sax.sina.com.cn, reject
host, saxn.sina.com.cn, reject
host, saxs.sina.com.cn, reject
host, u1.img.mobile.sina.cn, reject

# [rewrite_local]
# 首页,签到,发布按钮,侧边栏,右上角红包,顶部标签页,侧边栏提醒,超话标签页悬浮,顶部直播
^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? url reject-dict

# 详情页,超话,评论区,看图界面,个人主页,我的页面,信息流,商品橱窗,视频流,视频号,视频调查,话题卡片
^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/photo\/info\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) url reject-dict

# 发现页,热门微博信息流,搜索列表,热搜提醒,猜你想搜,视频流红包
^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? url reject-dict

{# 视频页 #} ^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? url reject-dict

# 开屏广告 //*.uve.weibo.com
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime url reject-dict
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) url reject-dict

# 微博长文章推广
^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) url reject-dict
^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) url reject-dict
# 移除首页推广
^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除首页顶部标签
^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除信息流广告
^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除评论区广告
^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除个人微博详情页广告
^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除关注、取消关注弹窗
^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除个人主页广告
^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除超话搜索页广告
^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除评论区广告
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除信息流广告
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除微博详情页广告
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除视频流广告
^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除超话顶部标签
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除消息页列表广告
^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除消息页提醒
^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除热门微博信息流广告
^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除发现页搜索结果广告
^https:\/\/api\.weibo\.cn\/2\/searchall\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除开屏广告 preload
^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除开屏广告 sdkad
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 移除开屏广告 wbapplua
^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua) url script-response-body https://rucu6.pages.dev/Scripts/weibo.js
# 会员图标
^https:\/\/new\.vip\.weibo\.cn\/aj\/appicon\/list\? url script-response-body https://rucu6.pages.dev/Scripts/weibo.js

# [mitm]
hostname = *.weibo.cn, *.weibo.com, weibo.com
