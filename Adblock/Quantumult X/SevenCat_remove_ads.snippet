# [filter_local]
host, cdn-ad.wtzw.com, reject
host, cdn-new-ad.wtzw.com, reject
host-suffix, gdt.qq.com, reject

# [rewrite_local]
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\/ url reject-dict
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose url reject-dict
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config url reject-dict
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book url reject-dict
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation url reject-dict
(?i)^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ url reject
(?i)^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet url reject-dict
(?i)^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json url reject-dict

(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\/ url reject
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\/ url reject
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index url reject-dict
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch url reject-dict
(?i)^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init url reject-dict

(?i)^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\? url jsonjq-response-body 'delpaths([["data","func_area",1],["data","func_area",2]])'

# [mitm]
hostname = api-cfg.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, api-bc.wtzw.com, api-gw.wtzw.com, cdn.wtzw.com
