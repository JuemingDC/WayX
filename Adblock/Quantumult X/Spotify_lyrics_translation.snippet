# [filter_local]

# [rewrite_local]
# 跟踪响应·JSON
^https?:\/\/api\.spotify\.com\/v1\/tracks\? url script-response-body https://kelee.one/Resource/JavaScript/Spotify/Spotify_response.js

# 歌词请求·JSON
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json url script-request-body https://kelee.one/Resource/JavaScript/Spotify/Spotify_request.js
# 歌词请求·Proto
# [WayX] Source binary_body_mode=true ignored for Quantumult X; requires_body alone selects script-request/response-body, matching KOP-XIAO resource-parser conversion behavior.
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*) url script-request-body https://kelee.one/Resource/JavaScript/Spotify/Spotify_request.js

# 翻译歌词响应·JSON
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate url script-response-body https://kelee.one/Resource/JavaScript/Spotify/Translate_response.js
# 翻译歌词响应·Proto
# [WayX] Source binary_body_mode=true ignored for Quantumult X; requires_body alone selects script-request/response-body, matching KOP-XIAO resource-parser conversion behavior.
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate url script-response-body https://kelee.one/Resource/JavaScript/Spotify/Translate_response.js

# 外部歌词响应·JSON
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External url script-response-body https://kelee.one/Resource/JavaScript/Spotify/External_Lyrics_response.js
# 外部歌词响应·Proto
# [WayX] Source binary_body_mode=true ignored for Quantumult X; requires_body alone selects script-request/response-body, matching KOP-XIAO resource-parser conversion behavior.
^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External url script-response-body https://kelee.one/Resource/JavaScript/Spotify/External_Lyrics_response.js

# [mitm]
hostname = api.spotify.com, spclient.wg.spotify.com
