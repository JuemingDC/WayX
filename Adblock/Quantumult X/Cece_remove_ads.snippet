^https:\/\/api\.cece\.com\/user\/init\? url jsonjq-response-body 'del(.data.launch_img_url, .data.launch_goto_url)'

^https:\/\/api\.cece\.com\/common\/app\/app_config\? url jsonjq-response-body 'if (try (getpath(["data"]) | has("is_new_year")) catch false) then setpath(["data","is_new_year"]; false) else . end | if (try (getpath(["data"]) | has("spring_festival")) catch false) then setpath(["data","spring_festival"]; false) else . end | if (try (getpath(["data"]) | has("show_feedback_entry")) catch false) then setpath(["data","show_feedback_entry"]; false) else . end | if (try (getpath(["data"]) | has("show_course_entry")) catch false) then setpath(["data","show_course_entry"]; false) else . end | if (try (getpath(["data"]) | has("show_store_entry")) catch false) then setpath(["data","show_store_entry"]; false) else . end | if (try (getpath(["data"]) | has("show_luna")) catch false) then setpath(["data","show_luna"]; false) else . end | if (try (getpath(["data"]) | has("show_ead")) catch false) then setpath(["data","show_ead"]; false) else . end | if (try (getpath(["data"]) | has("show_ad")) catch false) then setpath(["data","show_ad"]; false) else . end | if (try (getpath(["data"]) | has("show_live_filter_tarot")) catch false) then setpath(["data","show_live_filter_tarot"]; false) else . end | if (try (getpath(["data"]) | has("community_feed_adswitch")) catch false) then setpath(["data","community_feed_adswitch"]; false) else . end | if (try (getpath(["data"]) | has("open_screen_ad_times")) catch false) then setpath(["data","open_screen_ad_times"]; 0) else . end | if (try (getpath(["data"]) | has("open_screen_ad_duration")) catch false) then setpath(["data","open_screen_ad_duration"]; 0) else . end | if (try (getpath(["data"]) | has("isShowThumbsGif")) catch false) then setpath(["data","isShowThumbsGif"]; false) else . end | if (try (getpath(["data"]) | has("teenager_mode_open")) catch false) then setpath(["data","teenager_mode_open"]; false) else . end | if (try (getpath(["data"]) | has("flu_log")) catch false) then setpath(["data","flu_log"]; false) else . end'

^https:\/\/api\.cece\.com\/common\/app\/app_config\? url jsonjq-response-body 'del(.data.activity_list, .data.fortune_ab_config)'

^https:\/\/api\.cece\.com\/user\/index\/banners\? url reject-dict

^https:\/\/api\.cece\.com\/chart\/tools\/home_10_tools\? url jsonjq-response-body '.data.tools |= map(del(.icon_tip_image))'

^https:\/\/api\.cece\.com\/user\/index\/tab_list\? url jsonjq-response-body '.data.tabs |= map(select(.type != "shop"))'

