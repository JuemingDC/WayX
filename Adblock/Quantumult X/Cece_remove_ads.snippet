^https:\/\/api\.cece\.com\/common\/app\/risk_entrance\? url jsonjq-response-body 'if (try (getpath(["data"]) | has("ai_fortune_show_ask_tool")) catch false) then setpath(["data","ai_fortune_show_ask_tool"]; false) else . end | if (try (getpath(["data"]) | has("ai_sign_show_ask_tool")) catch false) then setpath(["data","ai_sign_show_ask_tool"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_dice_card")) catch false) then setpath(["data","single_tool_show_dice_card"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_tarot_card")) catch false) then setpath(["data","single_tool_show_tarot_card"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_bazi_card")) catch false) then setpath(["data","single_tool_show_bazi_card"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_hepan_card")) catch false) then setpath(["data","single_tool_show_hepan_card"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_ziwei_card")) catch false) then setpath(["data","single_tool_show_ziwei_card"]; false) else . end | if (try (getpath(["data"]) | has("single_tool_show_xingpan_card")) catch false) then setpath(["data","single_tool_show_xingpan_card"]; false) else . end | if (try (getpath(["data"]) | has("multi_tool_show_card")) catch false) then setpath(["data","multi_tool_show_card"]; false) else . end | if (try (getpath(["data"]) | has("ai_ccai_show_multi_tool")) catch false) then setpath(["data","ai_ccai_show_multi_tool"]; false) else . end'

