^https:\/\/pan\.baidu\.com\/act\/api\/conf\?.*conf_key=youa_core_config_ios url reject-dict

^https:\/\/pan\.baidu\.com\/youai\/material\/v1\/getbynavid\?.*nav_id=1 url reject-dict

^https:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\? url jsonjq-response-body 'del(.data.service.config.advertisement, .data.service.config.youa.pm_config_ad)'

# [mitm]
hostname = pan.baidu.com, mbd.baidu.com
