# [rewrite_local]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.romielf\.com\/index\/indexv\d\? url jsonjq-response-body 'if (getpath(["data"]) | has("advertisement")) then (setpath(["data","advertisement"]; "[]")) else . end | if (getpath(["data"]) | has("listadvertising")) then (setpath(["data","listadvertising"]; "[]")) else . end'
^https:\/\/api\.romielf\.com\/index\/indexv\d\? url jsonjq-response-body '.data.list |= map(select(.type == 1))'

# [mitm]
hostname = api.romielf.com
