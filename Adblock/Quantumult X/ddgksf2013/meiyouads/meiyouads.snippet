# [mitm]
hostname = sub.seeyouyima.com, common.seeyouyima.com, users.seeyouyima.com, circle.xmseeyouyima.com, config-service.seeyouyima.com


# [filter_local]
host, jingqi.youzibuy.com, reject
host, mgo.seeyouyima.com, reject
host, ad.seeyouyima.com, reject
host, ad-logs.seeyouyima.com, reject
host, circle.seeyouyima.com, reject
host, ab.seeyouyima.com, reject

# [rewrite_local]
^https?:\/\/sub\.seeyouyima\.com\/v\d\/sub\/my_vip url jsonjq-response-body '.data={}'
^https?:\/\/common\.seeyouyima\.com\/v\d\/conf_list url reject
^https?:\/\/users\.seeyouyima\.com\/v\d\/wo\? url jsonjq-response-body 'del(.data.circle)'
^https?:\/\/circle\.xmseeyouyima\.com\/v\d\/feeds_recommend\? url jsonjq-response-body 'del(.data.activity_card)'
^https?:\/\/config-service\.seeyouyima\.com\/api\/configs\/batch url reject-200
