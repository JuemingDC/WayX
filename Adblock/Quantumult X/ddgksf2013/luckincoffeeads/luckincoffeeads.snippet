// ==/UserScript==


# [mitm]
hostname = capi.lkcoffee.com, 119.29.29.87

# [rewrite_local]
^https:\/\/capi\.lkcoffee\.com\/resource\/(?:m\/(?:sys\/(?:config\/value|common\/modules|homePage\/(?:common|contactor)\/modules|base\/myPageSectionShow\/newUI|app\/(?:adposNew|carousel)|visual\/effect\/modules)|aigc\/showAIButton)|seckill\/ar\/campaignBaseInfo) url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/ddgksf2013/luckincoffeeads/luckincoffee.ads.js
^https:\/\/119\.29\.29\.87\/d url reject-200
