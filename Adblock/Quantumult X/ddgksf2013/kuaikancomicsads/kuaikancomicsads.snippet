// ==UserScript==
// @ScriptName        快看漫画净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @Feedback          📮 ddgksf2013@163.com 📮
// @UpdateTime        2025-12-24
// @Suitable          自行观看“# > ”注释内容
// @Attention         使用前请快看漫画，挂载脚本然后使用
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.4
// @ScriptURL         https://ddgksf2013.top/rewrite/KuaiKanComicsAds.conf
// ==/UserScript==



# [mitm]
hostname = api.kkmh.com,cdn-api.kkmh.com,cdn-search.kkmh.com, search.kkmh.com,pay.kkmh.com, cdn-pay.kkmh.com

# > 青少年
# [rewrite_local]
^https?:\/\/.*kkmh\.com\/v\d\/app\/young_config\/get url reject-200
# > 搜索填词
^https?:\/\/.*kkmh\.com\/search\/app\/shading_word\/v\d\/list\? url jsonjq-response-body '.data.shading_words=[]'
# > 搜索下方
^https?:\/\/.*kkmh\.com\/v\d\/search\/show url jsonjq-response-body '.data.info=[]'
# > 图标右上推广
^https?:\/\/.*kkmh\.com\/v\d\/kb\/wallet\? url jsonjq-response-body '.data.activity={}'
# > 会员弹窗
^https?:\/\/.*kkmh\.com\/v\d\/vip\/nameplate\/list_all\? url reject-200
# > 我页面推广
^https?:\/\/.*kkmh\.com\/v\d\/vip\/(charge_tip_list|banner_tip_list)\? url jsonjq-response-body '.data.list=[]'
# > 推广弹窗
^https?:\/\/.*kkmh\.com\/v\d\/vip\/platform_base\/popups_display url jsonjq-response-body '.data.popup_list=[]'
# > 我的页面
^https?:\/\/.*kkmh\.com\/v\d\/business\/mine\/business_config\? url jsonjq-response-body '.data.module_config=[]'
# > 右下活动
^https?:\/\/.*kkmh\.com\/v\d\/business\/activities\/get url reject-200
# > 主页右上
^https?:\/\/.*kkmh\.com\/v\d/ironman/discovery_v2/tab_list_v3\?gender=0&location=7 url jsonjq-response-body '.data.list=[]'
# > 通用广告
^https?:\/\/.*kkmh\.com\/v\d\/(ad|advertisement)\/ url reject-200
# > 帖子页面
^https?:\/\/.*kkmh\.com\/v\d\/ironman\/topic_detail\/tabs\? url jsonjq-response-body '.data={}'
# > 下一话推荐
^https?:\/\/.*kkmh\.com\/v\d\/ironman\/comic\/recommend\? url reject-200
# > 话之间评论
^https?:\/\/.*kkmh\.com\/v\d\/comments\/cruel\/hot_floor_list url jsonjq-response-body '.data={}'
# > 浮标
^https?:\/\/.*kkmh\.com\/v\d\/checkin\/task_center\/checkin_list_for_home_page_pop url jsonjq-response-body '.data={}'
# > 顶部浮窗
^https?:\/\/.*kkmh\.com\/v\d\/business\/fake_push\/info url reject-200
# > 广告显示
^https?:\/\/.*kkmh\.com\/v\d\/topic\/discovery_v2\/list url response-body ad_show":1 response-body ad_show":0
