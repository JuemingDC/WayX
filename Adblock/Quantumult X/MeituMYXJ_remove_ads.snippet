# [filter_local]
host, adui.tg.meitu.com, reject

# [rewrite_local]
^https:\/\/api\.meiyan\.com\/operation\/home_banner\.json\? url reject-dict

^https:\/\/api\.meiyan\.com\/vip\/permission_update_popup\.json\? url reject-dict
^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? url jsonjq-response-body 'del(.response.time_limit, .response.bubble, .response.person_center)'
^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? url jsonjq-response-body 'if getpath(["response","function_pop","meiyan_style","is_pop"]) then setpath(["response","function_pop","meiyan_style","is_pop"]; false) else . end | if getpath(["response","onoff","vip_half_window_exit_remain_popup","open"]) then setpath(["response","onoff","vip_half_window_exit_remain_popup","open"]; 0) else . end | if getpath(["response","onoff","vip_home_exit_remain_popup"]) then setpath(["response","onoff","vip_home_exit_remain_popup"]; 0) else . end'
# 精简首页功能栏目并移除美颜推荐
^https:\/\/api\.meiyan\.com\/operation\/home\.json\? url script-response-body https://kelee.one/Resource/JavaScript/MeituMYXJ/MeituMYXJ_remove_ads.js

# [mitm]
hostname = api.meiyan.com
