# 广告下发
# Source declaration: ^http:\/\/139\.196\.12\.179:8053\/httpdns\/ url REJECT
^http:\/\/139\.196\.12\.179:8053\/httpdns\/ url reject
# Source declaration: ^http:\/\/106\.55\.220\.18:8053\/httpdns\/ url REJECT
^http:\/\/106\.55\.220\.18:8053\/httpdns\/ url reject
# Source declaration: ^http:\/\/54\.222\.159\.138:8053\/httpdns\/ url REJECT
^http:\/\/54\.222\.159\.138:8053\/httpdns\/ url reject
# Source declaration: ^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ url REJECT
^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ url reject
# 主页实惠卡横幅
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my url REJECT
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my url reject
# 搜索框页面热榜
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/hub\/camel\/search_input_ranking url reject-dict
# 朴朴超市订单待收货页右下角悬浮广告
^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order url reject-dict
# 购物车页去换购推荐
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2 url reject-dict
# 各种页面的商品推荐
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2 url reject-dict
# 个人主页会员标识
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center url reject-dict

# 消息中心促销消息未读提示
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number url jsonjq-response-body .data = []
^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number url jsonjq-response-body '.data = []'
# 搜索热词
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 url jsonjq-response-body .data = []
^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 url jsonjq-response-body '.data = []'
# 搜索结果页信息流横幅广告
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6 url jsonjq-response-body .data.feed_banner_cards = []
^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6 url jsonjq-response-body '.data.feed_banner_cards = []'
# 下单页实惠卡开通推荐
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail url jsonjq-response-body .data.member_card_v2 = []
^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail url jsonjq-response-body '.data.member_card_v2 = []'

# 开屏广告、首页横幅等
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1 url script-response-body https://github.com/ishowshu/qx/raw/refs/heads/main/script/pp.js
# 订单列表骑手反馈问题推荐
^https:\/\/j1\.pupuapi\.com\/client\/order\/orders\/list\/v4 url script-response-body https://github.com/ishowshu/qx/raw/refs/heads/main/script/pp.js

# [mitm]

# Upstream hostname = j1.pupuapi.com

hostname = j1.pupuapi.com
