^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do$ url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["functionOperatorInfoList"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["memberOperator"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["activityTabInfoList"]) else . end) catch $__wayx_before)'

