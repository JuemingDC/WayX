# [filter_local]

# [rewrite_local]
^https:\/\/app\.huashi6\.com\/app\/index\/ad\/ url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/app\.huashi6\.com\/app\/common\/config$ url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then if (try (getpath(["data"]) | has("disableAd")) catch false) then setpath(["data","disableAd"]; true) else . end else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then if (try (getpath(["data"]) | has("showTopFloatAdvanceTips")) catch false) then setpath(["data","showTopFloatAdvanceTips"]; false) else . end else . end) catch $__wayx_before)'
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/app\.huashi6\.com\/app\/common\/config$ url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["adsConfigIOS"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["adsConfigAndroid"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["url"]["tabMarket"]) else . end) catch $__wayx_before)'

^https:\/\/app\.huashi6\.com\/app\/common\/layouts$ url jsonjq-response-body '.data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}'

^https:\/\/app\.huashi6\.com\/app\/common\/themeConfig$ url jsonjq-response-body '.data.tabbars |= map(select(.title != "商城"))'

^https:\/\/app\.huashi6\.com\/app\/works\/relative$ url reject-dict

^https:\/\/app\.huashi6\.com\/app\/index\/follow\/all_random\/list$ url reject-dict

^https:\/\/app\.huashi6\.com\/app\/index\/csyxh\/icon$ url reject-dict

# [mitm]
hostname = app.huashi6.com
