# Name: 微博轻享版去广告
# Description: 移除开屏广告、时间线广告及评论区广告，移除发现页面横幅推广、最常访问、主页访客及热门视频，移除搜索填充词。
# Open URL: https://apps.apple.com/app/id1215210046
# Author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Tags: 去广告
# Homepage: https://hub.kelee.one
# Icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo_intl.png
# Updated: 2026-10-02 13:57:49

# Converted: 2026-10-04 15:08:50 +08:00
# Converted by: chance
# Category: 去广告
# Source: https://kelee.one/Tool/Loon/Lpx/Weibo_intl_remove_ads.lpx
# Target: Quantumult X

# [filter_local]

# [rewrite_local]
^https:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload$ url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["banner"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["user_footprint"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["profile_accessrecord"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["native_content"]) else . end) catch $__wayx_before)'
^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends url jsonjq-response-body '.data.discover |= map(select(.schema != "尊享会员"))'

^https:\/\/api\.weibo\.cn\/2\/cardlist\?v_f=2 url reject-dict

^https:\/\/api\.weibo\.cn\/2\/ad\/ url reject-dict
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$ url jsonjq-response-body 'if type == "object" then del(.["advertises"]) else . end | if type == "object" then del(.["ad"]) else . end | if type == "object" then del(.["ad_version_2_weibo"]) else . end'
^https:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline$ url jsonjq-response-body '.statuses|=map(select(.ad_marked!=true))'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$ url jsonjq-response-body 'if type == "object" then del(.["ad"]) else . end | if type == "object" then del(.["ad_version_2_weibo"]) else . end'
^https:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$ url jsonjq-response-body '.statuses|=map(select(.ad_marked!=true))'

^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\? url jsonjq-response-body '.datas[].data.ad_from_comment? = true'

^https:\/\/api\.weibo\.cn\/2\/statuses\/container_detail\? url jsonjq-response-body '.pageHeader.data.items |= (if . == null then [] else map(select(.data.itemid != "top_searching")) end)'

^https:\/\/api\.weibo\.cn\/2\/cardlist\?aid= url jsonjq-response-body '.cards |= map(select((.mblog?|(.ad_marked?|type=="boolean")and.ad_marked==true)or(.card_group?|type=="array"and any(.[]?;.mblog?|(.ad_marked?|type=="boolean")and.ad_marked==true))|not))'

^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_searching_info url reject-dict

^https:\/\/weibointl\.api\.weibo\.cn\/portal\.php\? url jsonjq-response-body '.data.cards |= map(.items |= map(if .type == "personal_vip" then .right_text = "" else . end))'

# [mitm]
hostname = bootpreload.uve.weibo.com, weibointl.api.weibo.cn, api.weibo.cn
