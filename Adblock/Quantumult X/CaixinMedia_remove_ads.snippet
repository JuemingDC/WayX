# [filter_local]

# [rewrite_local]
^https:\/\/entities\.caixin\.com\/api\/(dataplus\/promotionHints|public\/push\/appIndex|public\/recommendNews) url reject-dict

^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxAdInfo\/selectIndexAdInfo url reject-dict
^https:\/\/mappsv5\.caixin\.com\/channelv5\/article_ad_ios_info\.json url reject-dict

^https:\/\/gg\.caixin\.com\/s\?z=caixin&slot=\d+ url reject-dict

^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist url reject-dict
# 移除财新数据通广告
^https:\/\/entities\.caixin\.com\/api\/dataplus\/columns url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js

# 移除文末广告
^https:\/\/gateway\.caixin\.com\/api\/app-api\/(caixinapp\/appinfo|search\/getkeyword) url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js

# 移除财新FM广告
^https:\/\/gateway\.caixin\.com\/api\/app-content\/fm\/index\/list\? url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js

# 移除开屏广告
^https:\/\/gg\.caixin\.com\/s\?z=caixin&op=\d url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js

# 移除正文广告
^https:\/\/mappsv5\.caixin\.com\/articlev5\/\d+\/\d+\.json$ url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js
# 移除正文广告
^https:\/\/mapps?v5\.caixin\.com\/(channelv5\/list|\/?index_page_v5\/)\w+ url script-response-body https://kelee.one/Resource/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js

# [mitm]
hostname = e*.caixin.com, g*.caixin.com, m*.caixin.com
