host-suffix, zhixuexingtu.cn, reject


# [rewrite_local]

# 清空首页广告链
# 2026-10-02 复核：该接口返回首页广告 advId 链，直接清空，避免顶部轮播和下方横幅继续渲染。
^https:\/\/v3-api\.china-qzxy\.cn\/project\/adv\/chain\/get(?:\?|$) url jsonjq-response-body '.data = []'

# 清空广告 SDK 的全部广告位 ID
# 2026-10-02 同时关闭 jumpDDLWay，避免广告口令/深链继续触发跳转。
^https:\/\/v3-api\.china-qzxy\.cn\/project\/advSpace\/app\/v2\/list(?:\?|$) url jsonjq-response-body '.data.openAdvId = "" | .data.cutAdvId = "" | .data.nativeAdvId = "" | .data.feedAdvId = "" | .data.feedGroupAdvId = "" | .data.jutuiIconAdvId = "" | .data.jutuiFloatAdvId = "" | .data.jutuiTextLinkAdvId = "" | .data.yifanTextLinkAdvId = "" | .data.commandAdvStr = "" | .data.jumpDDLWay = 0'

# 将当前项目加入任务广告黑名单，并移除任务图
# 改为脚本动态读取 projectId：保留原有黑名单，且只修改已存在的广告字段，避免误伤项目核心配置。
# 2026-10-02 复核：不再依赖黑名单和远程脚本，直接关闭客户端广告开关、广告等级并移除 taskImg。
^https:\/\/v3-api\.china-qzxy\.cn\/project\/info\/triple(?:\?|$) url jsonjq-response-body '.data.clientProjectInfoSwitchDTO.screenAdvertisingSwitch = 0 | .data.clientProjectInfoSwitchDTO.appAdvertiseSwitch = 0 | .data.clientProjectInfoSwitchDTO.jobAdvertisingSwitch = 0 | .data.clientProjectInfoConfigDTO.appAdvertiseLevel = 0 | .data.clientProjectInfoConfigDTO.taskImg = null'
# 整体隐藏“每天赚（省）点零花钱 / 可提现金”模块
# 该接口同时包含 coinInfo 与 appAdvChannelList；脚本先校验当前 HAR 结构，确认匹配后才将 data 置空。
# 2026-10-02 复核：当前响应下发 12 个广告入口；直接将 data 置空，避免黑色收益区、图标宫格和下方运营卡片继续渲染。
^https:\/\/v3-api\.china-qzxy\.cn\/user\/coin\/info\/withAppAdvChannel(?:\?|$) url jsonjq-response-body '.data = null'

# 清空霸王餐/免费餐推广数据
^https:\/\/v3-api\.china-qzxy\.cn\/settlement\/advertise\/freeMeal\/activity\/index(?:\?|$) url jsonjq-response-body '.data.amount = 0 | .data.activityList = []'

# 拦截广告点击上报
^https:\/\/v3-api\.china-qzxy\.cn\/project\/clickAdv(?:\?|$) url reject-dict

# 拦截服务端任务广告素材
^https:\/\/oss\.china-qzxy\.cn\/qzxy_images\/adv\/ url reject-img


# [mitm]
hostname = v3-api.china-qzxy.cn, oss.china-qzxy.cn
