# [rewrite_local]
^https:\/\/v3-api\.china-qzxy\.cn\/(?:user\/coin\/info\/withAppAdvChannel|project\/adv\/chain\/get|project\/advSpace\/app\/v2\/list|settlement\/advertise\/freeMeal\/activity\/index|project\/info\/triple|project\/iconSlogan)(?:\?|$) url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/QZXY/QuantumultX/qzxy.js
# 广告点击、归因与已确认素材，避免屏蔽整个共享 OSS。
^https:\/\/v3-api\.china-qzxy\.cn\/project\/clickAdv(?:\?|$) url reject-dict
^https?:\/\/101\.126\.18\.212\/report\/channel(?:\?|$) url reject-dict
^https:\/\/oss\.china-qzxy\.cn\/qzxy_images\/(?:adv\/|prod\/(?:0a87648bf938f8835ca7538ce5db44c8|1cd4f79fc0624a6715a2d060b1cbc93e|2125112e7f68357bbdc6019a06bb31ff|4804872c27c722e25391a4dffb57996b|63b7b6fa7d2d27a236fb77d0ad405bc6|66d46f770e852dfd71244bb38cb10f05|693c8d5cfa102fe01272db57f03d7f46|69e72787740ee18226adca6b0b610a95|70cc25df0ff8644632de4f85d8be732d|7bdaaa68e66951c3c5697a6551a40a28|998a71c47c0872aa7e83463607a80622|9caef3692060104047733da082cd2d9f|c3a415f68503c37364a0d024aced32f3)\.png(?:\?|$)) url reject-img

