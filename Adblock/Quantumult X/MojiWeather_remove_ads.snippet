# [filter_local]

# [rewrite_local]
^https:\/\/fcard\.api\.moji\.com\/flycard\/flyCard\? url reject

^https:\/\/vdo\.api\.moji\.com\/shortvideo\/card\/subscribe$ url reject-dict
^https:\/\/vdo\.api\.moji\.com\/shortvideo\/video\/index_flow\? url reject-dict
^https:\/\/vdo\.api\.moji\.com\/shortvideo\/video_user\/hotGuyRcm\? url reject-dict
^https:\/\/vdo\.api\.moji\.com\/shortvideo\/zone\/follow_src_zone\? url reject-dict

^https:\/\/sns\.api\.moji\.com\/user\/dynamic_v9\/json\/someone_interest\? url reject-dict

^https:\/\/mme\.api\.moji\.com\/json\/entrance\/list$ url jsonjq-response-body 'del(.entrance_region_res_list[] | select(.region_name == "皇冠区域" or .region_name == "banner区")) | .entrance_region_res_list[].entrance_res_list |= if . then map(select(.entrance_name | . != "墨迹钱包" and . != "墨圈")) else . end'

# [mitm]
hostname = fcard.api.moji.com, vdo.api.moji.com, sns.api.moji.com, mme.api.moji.com, psnlz.api.moji.com
