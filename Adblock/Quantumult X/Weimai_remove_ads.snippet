# [filter_local]

# [rewrite_local]
^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? url jsonjq-response-body 'if (try (getpath([]) | has("isShowCJAd")) catch false) then setpath(["isShowCJAd"]; 0) else . end'
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? url jsonjq-response-body 'if type == "object" then del(.["launchAd"]) else . end | if type == "object" then del(.["adBanners"]) else . end | if type == "object" then del(.["ad"]) else . end'

# [mitm]
hostname = confssl*.iweimai.cn
