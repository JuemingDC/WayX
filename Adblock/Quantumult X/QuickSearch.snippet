# [filter_local]

# [rewrite_local]

(?i)^https:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+ url 307 https://www.baidu.com/s?wd=$1
(?i)^https:\/\/duckduckgo\.com\/\?q=bdimg\+([^&]+).+ url 307 https://image.baidu.com/search/index?tn=baiduimage&word=$1
(?i)^https:\/\/duckduckgo\.com\/\?q=gimg\+([^&]+).+ url 307 https://www.google.com/search?&tbm=isch&q=$1
(?i)^https:\/\/duckduckgo\.com\/\?q=b\+([^&]+).+ url 307 https://www.bing.com/search?q=$1
(?i)^https:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+ url 307 https://zh.wikipedia.org/wiki/$1
(?i)^https:\/\/duckduckgo\.com\/\?q=qm\+([^&]+).+ url 307 https://www.qimai.cn/search/index/country/cn/search/$1
(?i)^https:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+ url 307 https://github.com/search?q=$1
(?i)^https:\/\/duckduckgo\.com\/\?q=(?!(?:bd|bdimg|gimg|b|wk|qm|gh)\+)([^&]+).+ url 307 https://www.google.com/search?q=$1

# [mitm]
hostname = duckduckgo.com
