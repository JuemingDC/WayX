# [rewrite_local]
(?i)^https?:\/\/interface\.music\.163\.com\/eapi\/ad url reject
(?i)^https?:\/\/c\.m\.163\.com\/nc\/gl\/ url reject
(?i)^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/searchMultiAds url reject
(?i)^https?:\/\/g1\.163\.com\/madfeedback url reject
