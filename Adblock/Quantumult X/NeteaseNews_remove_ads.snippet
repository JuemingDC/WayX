(?i)^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json url reject
(?i)^https?:\/\/interface3?\.music\.163\.com\/eapi\/(ad|abtest|sp|hot|store|search\/(specialkeyword|defaultkeyword|hot)) url reject
# 移除网易新闻广告
(?i)^https:\/\/nex\.163\.com\/q url script-response-body https://kelee.one/Resource/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js

# 移除网易新闻广告
(?i)^https:\/\/gw\.m\.163\.com\/nc\/api\/v1\/feed\/dynamic\/headline-list\? url script-response-body https://kelee.one/Resource/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js

# 移除网易新闻广告
