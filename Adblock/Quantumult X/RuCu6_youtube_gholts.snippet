^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/0b8b47c8cd9841e2029a314dc44e27fb7918541d2f71b501e659cddd3b091124/request_gholts.js
