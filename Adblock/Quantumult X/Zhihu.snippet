# [rewrite_local]
# 首页 - 悬浮图标、顶部横幅、开屏广告、关注页推荐、推荐信息流、热榜信息流、热榜直播、回答底部卡片
^https:\/\/api\.zhihu\.com\/commercial_api\/ url reject-dict
^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings url reject-dict
^https:\/\/api\.zhihu\.com\/(?:moments\/lastread|drama\/hot-drama-list) url reject-dict
^https:\/\/api\.zhihu\.com\/root\/window url reject-dict

# 会员页面 - 弹窗、悬浮动图
^https:\/\/api\.zhihu\.com\/(?:bazaar\/float_window|market\/popovers_v2) url reject-dict
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header\? url jsonjq-response-body 'delpaths([["activity_banner"],["activity_window"],["vip_tip"]])'

# 我的页面 - 项目列表、会员卡片
^https:\/\/api\.zhihu\.com\/me\/guides url reject-dict
^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v2 url reject-dict
^https:\/\/api\.zhihu\.com\/unlimited\/go\/my_card url reject
^https:\/\/www\.zhihu\.com\/appview\/v3\/zhmore url reject

# 搜索页 - 关键词、猜你想搜
^https:\/\/api\.zhihu\.com\/search\/(hot_search|preset_words) url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/search\/clicked_recommendation\? url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/(?:article|answer)\/\d+ url reject-dict
^https:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\? url response-body recommend_queries:\{.+\} response-body recommend_queries:{}

# 回答详情页 - 评论区顶部、下一个回答
^https:\/\/api\.zhihu\.com\/comment_v5\/(?:articles|answers)\/\d+\/list-headers url reject-dict
^https:\/\/api\.zhihu\.com\/prague\/related_suggestion_native\/feed\? url reject-dict
^https:\/\/api\.zhihu\.com\/related_recommend\/feed\/waterfall\? url reject-dict
^https:\/\/api\.zhihu\.com\/v5\.1\/topics\/answer\/\d+\/relation url reject-dict
^https:\/\/api\.zhihu\.com\/comment_v5\/(pins\/)?\d+\/root_comment\? url jsonjq-response-body 'delpaths([["atmosphere_voting_config"]])'
^https:\/\/api\.zhihu\.com\/questions\/\d+(?:\/answers|\/feeds|\?include=) url jsonjq-response-body 'del(.ad_info, .data.ad_info?, .query_info) | if (.data | type) == "array" then .data |= map(select(.target?.answer_type? // "" | tostring | contains("paid") | not)) else . end'

# 其他 - 服务器推送配置
^https:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config url reject-dict
^https:\/\/api\.zhihu\.com\/ad-style-service\/request url reject-dict
^https:\/\/appcloud2\.zhihu\.com\/v3\/resource\?group_name=mp url reject-dict
^ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Zhihu/redirect_c09554f6b9.js

# 网页版去广告
^https:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\? url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/hot_recommendation url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/mcn\/v2\/linkcards\? url reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/(?:answers|questions)\/\d+\/related-readings url reject-dict
^https:\/\/www\.zhihu\.com\/commercial_api\/banners_v3\/mobile_banner url reject-dict
^https:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation url reject-dict
# 移除回答底部卡片推广
^https:\/\/(?:api|page-info)\.zhihu\.com\/(?:answers|articles)\/v2\/\d+ url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除首页悬浮图标
^https:\/\/api\.zhihu\.com\/commercial_api\/app_float_layer url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除推荐信息流推广
^https:\/\/api\.zhihu\.com\/feed\/render\/tab\/config\? url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除推荐信息流推广
^https:\/\/api\.zhihu\.com\/(?:moments_v3|topstory\/hot-lists\/total|topstory\/recommend) url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 精简顶部标签
^https:\/\/api\.zhihu\.com\/root\/tab url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除热榜信息流推广
^https:\/\/api\.zhihu\.com\/v2\/topstory\/hot-lists\/everyone-seeing\? url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除下一个回答推广、评论区顶部推广
^https:\/\/api\.zhihu\.com\/next-(?:bff|data|render) url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 移除回答详情页推广
^https:\/\/www\.zhihu\.com\/api\/v4\/(?:articles|answers)\/\d+\/recommendations?\? url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 拦截服务器推送配置 config
^https:\/\/appcloud2\.zhihu\.com\/v3\/config url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js
# 拦截服务器推送配置 config all
^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\? url script-response-body https://rucu6.pages.dev/Scripts/zhihu.js

