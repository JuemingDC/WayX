^https://www\.youtube\.com/api/timedtext\? url script-response-body https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/yt-zh-sub.js

# [mitm]

# Upstream hostname = www.youtube.com
hostname = www.youtube.com
