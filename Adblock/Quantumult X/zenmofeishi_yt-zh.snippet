# Upstream name=YouTube 强制简体中文字幕
# [rewrite_local]
^https://www\.youtube\.com/api/timedtext\?.*_ytzhsub=1 url script-request-header https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-586340f11939/yt-sub-clean.js
^https://www\.youtube\.com/api/timedtext\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/raw.githubusercontent.com-941838a3032e/yt-zh-sub.js

# [mitm]
hostname = www.youtube.com
