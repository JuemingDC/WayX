# [rewrite_local]
^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list url reject-200

^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) url 307 $1$5$6
^https:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list url jsonjq-response-body 'delpaths([["data","pendant_a"],["data","entrance_d"]])'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config url jsonjq-response-body 'setpath(["greatGodGameSitterSwitch"]; 0) | setpath(["followMoreAnchorEntrance"]; 0) | setpath(["sdklivebanner"]; 0) | setpath(["homeActFloatSwitch"]; 0) | setpath(["bringGoodsSwitch"]; 0) | setpath(["qqGameSwitch"]; 0)'
