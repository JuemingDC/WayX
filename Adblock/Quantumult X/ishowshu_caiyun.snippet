# [filter_local]
host, abyss.cyapi.cn, reject
host, ad.cyapi.cn, reject

# [rewrite_local]
^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product) url reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) url reject-dict

^https:\/\/api\.caiyunapp\.com\/v1\/activity\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/github.com-18215ab2cd0e/caiyun.js
^https:\/\/biz\.cyapi\.cn\/(api\/v1\/user_detail|p\/v1\/vip_info|v2\/user) url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/github.com-18215ab2cd0e/caiyun.js
^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\? url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/github.com-18215ab2cd0e/caiyun.js
^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\? url script-request-header https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Adblock/github.com-18215ab2cd0e/caiyun.js

# [mitm]
hostname = api.caiyunapp.com, *.cyapi.cn
