# [rewrite_local]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/gateway\.36kr\.com\/api\/mis\/sys\/config\? url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["contentConfig"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["positionConfigList"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["switchConfig"]["ios"]["sunrise_sign"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["switchConfig"]["ios"]["sunrise_sunit_task"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["switchConfig"]["ios"]["sunrise_sunit_mall"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["switchConfig"]["ios"]["sunrise_distribution_icon"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["secondFloorConfig"]) else . end) catch $__wayx_before)'

^https:\/\/36kr\.com\/global\/sensors\/config\/iOS\.conf\? url jsonjq-response-body 'if (try (getpath(["configs"]) | has("disableSDK")) catch false) then setpath(["configs","disableSDK"]; true) else . end'

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\? url jsonjq-response-body '.data.navList |= [ .[] | select(.navNick == "home" or .navNick == "newsflash" or .navNick == "me") ]'

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/me\/recom\? url reject-dict

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/search\/hotword\? url reject-dict

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/search\/topicListV2\? url reject-dict

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/home\/subnav\/recom\? url jsonjq-response-body '.data.bannerList |= map(select(.itemType != 0))'

^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/home\/subnav\/flow\/ url jsonjq-response-body 'del(.data.adItemList)'

^https:\/\/gateway\.36kr\.com\/api\/adx\/ url reject-dict

^https:\/\/gateway\.36kr\.com\/api\/mis\/page\/article\/recom\? url reject-dict

^https:\/\/gateway\.36kr\.com\/api\/mis\/page\/newsflash\/recom\? url reject-dict

