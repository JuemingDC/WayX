# [filter_local]
host, weather-analytics-events.apple.com, reject
host, tether.edge.apple, reject
host-suffix, tthr.apple.com, reject
# [WayX] Quantumult X unsupported Rule type commented out; Rule conversion does not use Script fallback
# Source declaration: AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

# [rewrite_local]
# 天气可用性响应
# [WayX] Source Script argument ignored for Quantumult X, matching KOP-XIAO resource-parser conversion behavior.
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ url script-response-body https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js

# 天气响应
# [WayX] Source Script argument ignored for Quantumult X, matching KOP-XIAO resource-parser conversion behavior.
# [WayX] Source binary_body_mode=true ignored for Quantumult X; requires_body alone selects script-request/response-body, matching KOP-XIAO resource-parser conversion behavior.
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-response-body https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js

# [mitm]
hostname = weatherkit.apple.com
