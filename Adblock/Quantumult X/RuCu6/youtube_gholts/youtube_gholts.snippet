# WayX ID: AD0365
# Name: YouTube
# Description: 移除广告, 移除上传&短片按钮, 解锁播放速度&精彩跳转。
# Author: Maasea[https://github.com/Maasea/sgmodule], gholts[https://github.com/gholts/surge], RuCu6[https://github.com/RuCu6]
# Icon: https://rucu6.pages.dev/Icons/app/youtube.png
# Updated: 2026-10-22 20:55

# Updated: 2026-10-22 20:55
# Converted by: chance
# Category: 插件
# Source: https://rucu6.pages.dev/Plugins/youtube_gholts.lpx

# [filter_local]

# [rewrite_local]
(?i)^https:\/\/s\.youtube\.com\/api\/stats\/ads url reject
(?i)^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ url reject
# youtube_ad-break
(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/request_gholts.js
# youtube_init
(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/request_gholts.js
# youtube_auto-hd
(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/request_gholts.js
# youtube_log-event
(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/request_gholts.js
# youtube_response
(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/response_gholts.js
# youtube_key
(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/key_gholts.js
# youtube_ump
(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Quantumult%20X/RuCu6/youtube_gholts/ump_gholts.js

# [mitm]
hostname = rr*.googlevideo.com, s.youtube.com, www.youtube.com, youtubei.googleapis.com
