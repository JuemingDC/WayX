# [filter_local]
#AND, ((DOMAIN, youtubei.googleapis.com), (PROTOCOL, UDP)), REJECT
#AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, UDP)), REJECT

# [rewrite_local]
# loon 专用写法
#response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "", 200)
# youtube 短链移除追踪参数
(?i)(^https:\/\/youtu\.be\/[\w-]+)(?:\?si=\w+) url 302 $1
# youtube_request_init
# Disabled: upstream resource unavailable
# (?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* url script-request-body https://rucu6.pages.dev/Scripts/youtube/request.js
# youtube_request_log_event
# Disabled: upstream resource unavailable
# (?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event url script-request-body https://rucu6.pages.dev/Scripts/youtube/request.js
# youtube_response
# Disabled: upstream resource unavailable
# (?i)^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$ url script-response-body https://rucu6.pages.dev/Scripts/youtube/response.js

# [mitm]
hostname = rr*.googlevideo.com, youtu.be, youtubei.googleapis.com
