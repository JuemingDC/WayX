# Target: Quantumult X

# [WayX] Policy binding: source PROXY is preserved as literal QX policy name PROXY; a matching target policy must exist.

# [filter_local]
host-suffix, mypikpak.com, PROXY
host, 18hlw.com, PROXY
host, 8olbt.imsatcmn.cc, PROXY
host, yhg007.com, PROXY

# [rewrite_local]
# 解决 GitHub 速率限制返回429问题
#request if ${url} ~= /^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
#request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")

# 桌面端请使用 https://google.com/ncr
# 谷歌服务重定向 //*.google.cn
(?i)^https?:\/\/(www\.)?(?:g|google)\.cn url 302 https://www.google.com
(?i)^https?:\/\/translate\.google\.cn url 302 https://translate.google.com

{# Avple 跳转弹窗 //asserts.avple.tv #} (?i)^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js url reject

# 可莉仓库解除 UA 限制 //kelee.one
(?i)https:\/\/(rule\.)?kelee\.one\/ url request-header (?m)^()(?i:user-agent):[^\r\n]*(?:\r?\n|$) request-header $1
(?i)https:\/\/(rule\.)?kelee\.one\/ url request-header ^([^\r\n]+)(\r\n) request-header $1$2user-agent: Loon/786 CFNetwork/1568.200.51 Darwin/24.1.0$2
(?i)https:\/\/(rule\.)?kelee\.one\/ url response-header ^([^\r\n]+)(\r\n) response-header $1$2content-disposition: inline$2
(?i)https:\/\/(rule\.)?kelee\.one\/ url response-header (?m)^()(?i:content-type):[^\r\n]*(?:\r?\n|$) response-header $1
(?i)https:\/\/(rule\.)?kelee\.one\/ url response-header ^([^\r\n]+)(\r\n) response-header $1$2content-type: text/plain; charset=utf-8$2

{# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org #} (?i)^https:\/\/exhentai\.org url 307 https://e-hentai.org

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
(?i)^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$ url 302 $1
(?i)^https:\/\/www\.pornhub\.com\/ url 302 https://cn.pornhub.com/
(?i)^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads) url reject-dict
# ======= 普通网页 ======= #
# 百度 //boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com
# baidu_boxer
(?i)^https:\/\/boxer\.baidu\.com\/scheme\?scheme url script-request-body https://rucu6.pages.dev/Scripts/baidu/baiduNoRedirect.js
# baidu_home
(?i)^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$ url script-response-body https://rucu6.pages.dev/Scripts/webpage/baidu-index.js
# baidu_zhidao
(?i)^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word) url script-response-body https://rucu6.pages.dev/Scripts/webpage/baidu-zhidao.js

# guanying_web_ads
{# 观影 //www.hgeme.com, www.xn--wcv59z.com #} (?i)^https:\/\/www\.(?:hgeme|xn--wcv59z)\.com\/ url script-response-body https://rucu6.pages.dev/Scripts/webpage/myblockads.js

# 移花宫 //yhg007.com, *.111107?.xyz
# yihuagong_hash_ad
(?i)^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/hash\/(?:[a-fA-F0-9]{40}|[A-Z2-7]{32})\.html url script-response-body https://rucu6.pages.dev/Scripts/webpage/myblockads.js
# yihuagong_search_ads
(?i)^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/search-[^\/]+\.html url script-response-body https://rucu6.pages.dev/Scripts/webpage/myblockads.js

