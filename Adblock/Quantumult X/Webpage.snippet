# [WayX] Policy binding: source PROXY is preserved as literal QX policy name PROXY; a matching target policy must exist.
# [WayX] REVIEW REQUIRED: QX header.add cannot be represented losslessly: the official header object form does not prove duplicate-header preservation
# Source declaration: response if ${url} ~= /https:\/\/(rule\.)?kelee\.one\//i then response.header.add("content-disposition", "inline") | response if ${url} ~= /https:\/\/(rule\.)?kelee\.one\//i then response.header.set("content-type", "text/plain; charset=utf-8")

# [filter_local]
host-suffix, mypikpak.com, PROXY
host, 18hlw.com, PROXY
host, 8olbt.imsatcmn.cc, PROXY
host, yhg007.com, PROXY

# [rewrite_local]
# 解决 GitHub 速率限制返回429问题
#request if ${url} ~= /^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
#request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")

# 桌面端请使用 https://google.com/ncr
# 谷歌服务重定向 //*.google.cn
^https?://(www\.)?(?:g|google)\.cn url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/redirect_c6b7d5dbe6.js
^https?://translate\.google\.cn url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/redirect_b0a7bd4ec8.js

# Avple 跳转弹窗 //asserts.avple.tv
^https://asserts\.avple\.tv/file/avple-images/ad\.js url reject

# 可莉仓库解除 UA 限制 //kelee.one
https://(rule\.)?kelee\.one/ url script-request-header https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/header_eb9fc300bc.js

# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org
^https://exhentai\.org url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/redirect_1cb6a93724.js

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
^(https://cn\.pornhub\.com/view_video\.php\?viewkey=[^&]+)&.*$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/redirect_36a839ae2e.js
^https://www\.pornhub\.com/ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Webpage/redirect_4e266d46a5.js
^https://cn\.pornhub\.com/(?:interstitial|_xa/ads) url reject-dict
