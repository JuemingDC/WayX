# [rewrite_local]
# 解决 GitHub 速率限制返回429问题
#request if ${url} ~= /^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
#request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")

# 桌面端请使用 https://google.com/ncr
# 谷歌服务重定向 //*.google.cn
^https?:\/\/(www\.)?(?:g|google)\.cn url 302 https://www.google.com
^https?:\/\/translate\.google\.cn url 302 https://translate.google.com

{# Avple 跳转弹窗 //asserts.avple.tv #} ^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js url reject

# 可莉仓库解除 UA 限制 //kelee.one
https:\/\/(rule\.)?kelee\.one\/ url request-header (?m)^()(?i:user-agent):[^\r\n]*(?:\r?\n|$) request-header $1
https:\/\/(rule\.)?kelee\.one\/ url request-header ^([^\r\n]+)(\r\n) request-header $1$2user-agent: Loon/786 CFNetwork/1568.200.51 Darwin/24.1.0$2
https:\/\/(rule\.)?kelee\.one\/ url response-header ^([^\r\n]+)(\r\n) response-header $1$2content-disposition: inline$2
https:\/\/(rule\.)?kelee\.one\/ url response-header (?m)^()(?i:content-type):[^\r\n]*(?:\r?\n|$) response-header $1
https:\/\/(rule\.)?kelee\.one\/ url response-header ^([^\r\n]+)(\r\n) response-header $1$2content-type: text/plain; charset=utf-8$2

{# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org #} ^https:\/\/exhentai\.org url 307 https://e-hentai.org

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$ url 302 $1
^https:\/\/www\.pornhub\.com\/ url 302 https://cn.pornhub.com/
^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads) url reject-dict
