# Target: Quantumult X

# [filter_local]

# [rewrite_local]
^https:\/\/www\.kookapp\.cn\/api\/v3\/ad\/config$ url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ url jsonjq-response-body 'if type == "object" then del(.["ad_banner"]) else . end | if type == "object" then del(.["advertise_on_off"]) else . end'

^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ url jsonjq-response-body 'if (try (getpath([]) | has("ios_mall_switch")) catch false) then setpath(["ios_mall_switch"]; false) else . end'

^https:\/\/www\.kookapp\.cn\/api\/v3\/promotion\/ongoing$ url reject-dict

^https:\/\/www\.kookapp\.cn\/api\/v3\/discover\/tab-list\? url jsonjq-response-body '.data.items |= map(select(.id == 472 or .id == 473 or .id == 475))'

# [mitm]
hostname = m.kookapp.cn, www.kookapp.cn
