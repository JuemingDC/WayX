# [filter_local]
#AND, ((DOMAIN, youtubei.googleapis.com), (PROTOCOL, UDP)), REJECT
#AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, UDP)), REJECT

# [rewrite_local]
# loon 专用写法
#response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "", 200)
# youtube 短链移除追踪参数
(^https:\/\/youtu\.be\/[\w-]+)(?:\?si=\w+) url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/YouTube/redirect_26c750fd96.js
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon request binary_body_mode=true has no verified Quantumult X request-body bodyBytes example
# Source declaration: request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://rucu6.pages.dev/Scripts/youtube/request.js", {${captionLang}}) with tag="youtube_request_init", requires_body=true, binary_body_mode=true
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon request binary_body_mode=true has no verified Quantumult X request-body bodyBytes example
# Source declaration: request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://rucu6.pages.dev/Scripts/youtube/request.js") with tag="youtube_request_log_event", requires_body=true, binary_body_mode=true
# youtube_response
# [WayX] Source binary_body_mode=true; script source is preserved unchanged.
# [WayX] Source Script argument ignored for Quantumult X, matching KOP-XIAO resource-parser conversion behavior.
^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$ url script-response-body https://rucu6.pages.dev/Scripts/youtube/response.js

# [mitm]
hostname = rr*.googlevideo.com, youtu.be, youtubei.googleapis.com
