# [filter_local]
#AND, ((DOMAIN, youtubei.googleapis.com), (PROTOCOL, UDP)), REJECT
#AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, UDP)), REJECT

# [rewrite_local]
# loon 专用写法
#response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "", 200)
# youtube 短链移除追踪参数
(^https://youtu\.be/[\w-]+)(?:\?si=\w+) url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/YouTube/redirect_26c750fd96.js
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon Script v2 $argument cannot be carried by the official Quantumult X rewrite declaration without changing the script
# Source declaration: request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://rucu6.pages.dev/Scripts/youtube/request.js", {${captionLang}}) with tag="youtube_request_init", requires_body=true, binary_body_mode=true
# youtube_request_log_event
# [WayX] Source binary_body_mode=true; script source is preserved unchanged.
^https://youtubei\.googleapis\.com/youtubei/v1/log_event url script-request-body https://rucu6.pages.dev/Scripts/youtube/request.js
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon Script v2 $argument cannot be carried by the official Quantumult X rewrite declaration without changing the script
# Source declaration: response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$/i then script("https://rucu6.pages.dev/Scripts/youtube/response.js", {${blockImmersive}, ${blockShorts}, ${blockUpload}, ${debug}, ${captionLang}}) with tag="youtube_response", requires_body=true, binary_body_mode=true

# [mitm]
hostname = rr*.googlevideo.com, youtu.be, youtubei.googleapis.com
