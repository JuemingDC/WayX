# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/initData\/mini\? url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["bootpage"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["bottom_bar_activity"]) else . end) catch $__wayx_before)'
^https:\/\/apps\.api\.ke\.com\/config\/config\/bootpage\? url reject-dict

^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/feed\? url reject-dict

^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/info\? url jsonjq-response-body 'del(.data.islandModule)'

^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/userCenter\/info\? url jsonjq-response-body 'del(.data.mainIcons.list[] | select(.indexKey == "coupon"))'

^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/myhome\/pagedetail\? url jsonjq-response-body '.data.moduleList |= map(select(.tab != "myHomeDecorV4"))'

^https:\/\/apps\.api\.ke\.com\/config\/config\/getactivityconfig\? url reject-dict

^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/feed\? url jsonjq-response-body '.data.list |= map(select(.cardType == "houseContainer" or .cardType == "houseV2" or .cardType == "houseV3" or .cardType == "rentHouseDiscount" or .cardType == "decorationCase"))'

# [mitm]
hostname = apps.api.ke.com
