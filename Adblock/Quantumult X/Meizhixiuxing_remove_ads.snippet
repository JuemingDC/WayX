# [filter_local]

# [rewrite_local]
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/launch$ url reject-dict

^https:\/\/api\.bevol\.com\/appmain\/app\/home\/popup$ url reject-dict

^https:\/\/api\.bevol\.com\/personal\/page$ url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/page$ url jsonjq-response-body 'delpaths([["result","versionPopUp"],["result","isShowSearchLabel"],["result","isShowSearchFeedBack"],["result","centerBannerAdvert"],["result","programmaticAdvertising"],["result","mattsData"],["result","questionnaireMap"],["result","appPullDownAdvert"]])'

^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ url jsonjq-response-body 'delpaths([["result","banners"]])'
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ url jsonjq-response-body '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/api\.bevol\.com\/trialbox\/shop\/app\/homePage$ url jsonjq-response-body 'delpaths([["result","firstPersonActivity"],["result","mainActivity"],["result","brandZone"],["result","imageAD2"],["result","couponPopupInfo"]])'

^https:\/\/api\.bevol\.com\/seach\/foundAndTopSearch$ url reject-dict

# [mitm]
hostname = api.bevol.com
