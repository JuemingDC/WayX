# [filter_local]

# [rewrite_local]
^https:\/\/compus\.xiaofubao\.com\/compus\/advertising\/ url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/compus\.xiaofubao\.com\/compus\/user\/getUserExt$ url jsonjq-response-body '(. as $__wayx_before | try (if type == "object" then del(.["data"]["adPopSwitch"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["adSplashSwitch"]) else . end) catch $__wayx_before)'

^https:\/\/compus\.xiaofubao\.com\/compus\/application\/getHomeAppList$ url jsonjq-response-body '.rows|=map(select(.appCode=="kechengbiao_app1" or .appCode=="siliuji" or .appCode=="NEWJIAOFEIDATING"))'

# [mitm]
hostname = compus.xiaofubao.com
