# Updated: 2026-09-22 22:55

# Converted: 2026-09-29 21:03:27 +08:00
# Converted by: chance
# Category: 去广告
# Source: https://rucu6.pages.dev/Plugins/bilibili.lpx
# Target: Quantumult X

# Source [Argument] (declaration-only conversion; typed/dynamic arguments stay Review):
# displayUpList=select, "auto", "show", "hide", tag=显示 动态「最常访问」, desc=- auto: 仅当列表中存在直播状态时显示\n- show: 始终显示\n- hide: 始终隐藏
# optimizeRequest=switch, true, false, tag=过滤「视频内」插播广告, desc=自动跳过视频内广告\n- true: 开启\n- false: 关闭
# purifyComment=switch, true, false, tag=过滤「评论区」置顶广告, desc=-true: 开启\n- false: 关闭
# sponsorBlock=switch, true, false, tag=空降助手
# [WayX] Argument usage: displayUpList [string] -> Script argument-object
# [WayX] Argument usage: optimizeRequest [boolean] -> Script enable
# [WayX] Argument usage: purifyComment [boolean] -> Script argument-object
# [WayX] Argument usage: sponsorBlock [boolean] -> Script enable
# [WayX] Policy binding: source PROXY is preserved as literal QX policy name PROXY; a matching target policy must exist.

# [filter_local]
# 空降助手
host, bsbsb.top, PROXY

# 禁用STUN & P2P
# Unsupported logical rule for Quantumult X: AND, ((DOMAIN-SUFFIX, chat.bilibili.com), (OR, ((DOMAIN-KEYWORD, stun), (DOMAIN-KEYWORD, tracker), (DOMAIN-KEYWORD, p2p)))), REJECT

# 垃圾CDN
#AND, ((NOT, ((DEST-PORT, 8000))), (USER-AGENT, "Bilibili Freedoooooom/MarkII")), REJECT-NO-DROP

# 备用域名
host, api.biliapi.com, reject
host, api.biliapi.net, reject
host, app.biliapi.com, reject
host, app.biliapi.net, reject

# p2p
# Unsupported rule for Quantumult X: DEST-PORT, 4480, REJECT-NO-DROP
# Unsupported rule for Quantumult X: DEST-PORT, 4483, REJECT-NO-DROP
# Unsupported rule for Quantumult X: DEST-PORT, 8082, REJECT-NO-DROP
# Unsupported rule for Quantumult X: DEST-PORT, 9102, REJECT-NO-DROP

# 开屏广告
#URL-REGEX, "^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH", REJECT-VIDEO-NO-DROP
#URL-REGEX, "^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH", REJECT-VIDEO-NO-DROP

# [rewrite_local]
# 播放页开通会员的横幅
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_fac4d363ef.js
^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? url jsonjq-response-body '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? url jsonjq-response-body 'del(.data.payment)'

# 直播间
^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\? url jsonjq-response-body '.data |= (del(.play_together_info, .play_together_info_v2, .activity_banner_info) | if .function_card then .function_card[] = null end | if .new_tab_info.outer_list then .new_tab_info.outer_list |= map(select(.biz_id != 33)) end | if .card_list then .card_list |= map(select(.card_type | IN("banner_v2", "activity_card_v1") | not)) end | reduce ([["show_reserve_status"], false], [["reserve_info", "show_reserve_status"], false], [["shopping_info", "is_show"], 0]) as [$path, $value] (.; if getpath($path) then setpath($path; $value) end))'

# 开屏广告
^https:\/\/app\.bilibili\.com\/x\/resource\/peak\/download url reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\? url jsonjq-response-body '.data |= (del(.play_together_info, .play_together_info_v2, .activity_banner_info) | if .function_card then .function_card[] = null end | if .new_tab_info.outer_list then .new_tab_info.outer_list |= map(select(.biz_id != 33)) end | if .card_list then .card_list |= map(select(.card_type | IN("banner_v2", "activity_card_v1") | not)) end | reduce ([["show_reserve_status"], false], [["reserve_info", "show_reserve_status"], false], [["shopping_info", "is_show"], 0]) as [$path, $value] (.; if getpath($path) then setpath($path; $value) end))'
#response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?/i then response.body.mock("text", "OK", 200)
#response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\?/i then response.json.jq(".data |= with_entries(if .key | IN(\"show\", \"event_list\") then .value = [] else . end)")

# 屏蔽STUN
^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? url jsonjq-response-body '.data[][]?="stun.chat.bilibili.com:3478"'

# 满意度调研
^https:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? url reject-dict

# 大会员广告
^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials\? url reject-dict

# 直播广告
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? url reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? url jsonjq-response-body '.data.domains=["wss://tracker.chat.bilibili.com"]'

# IP请求、地理位置请求
^https:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp url reject-dict
^https:\/\/app\.bilibili\.com\/x\/resource\/ip url reject-dict

# 首页标签栏热更新
^https:\/\/app\.bilibili\.com\/x\/resource\/patch\/tab(\/v2)?\? url reject-dict

# 移除皮肤推送
^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\? url jsonjq-response-body 'delpaths([["data","common_equip"]])'

# 移除右上角活动入口
^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\? url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_32839594a9.js

# 搜索框填充词
^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square\? url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_b40b3a44d3.js

# 屏蔽默认搜索框关键词
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_fbdd48ab53.js

# 青少年模式
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_47c3f75a2a.js

# 视频暂停广告
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$ url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_70cda67371.js

# 移除直播间链接跟踪参数
(^https:\/\/live\.bilibili\.com\/\d+)(?:\/?\?.*) url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/redirect_59da899133.js

# 移除直播间游戏推广
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? url reject-dict

# 移除视频链接跟踪参数
(^https:\/\/(?:www|m)\.bilibili\.com\/video\/(?:BV\w{10}|av\d{9}))(?:\/?\?.*) url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/redirect_089914b029.js

# 哔哩哔哩漫画 开屏 && 底栏广告
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.Comic\/(?:Flash|ListFlash|GetActivityTab|GetBubbles) url script-echo-response https://raw.githubusercontent.com/JuemingDC/WayX/main/script/Bilibili/mock_72464b6f06.js

# 哔哩哔哩漫画 广告
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v1\.(?:Comic\/AppInit|Home\/HomeFeed)\? url jsonjq-response-body '.data as $data | .data[("activity_tab", "flash", "operate") | select($data[.])]=null | if .data.feeds then .data.feeds |= map(select(.type | IN(15, 30) | not)) end'
# [WayX] SCRIPT V2 REVIEW REQUIRED: dynamic enable cannot be carried by Quantumult X rewrite declaration without changing the script
