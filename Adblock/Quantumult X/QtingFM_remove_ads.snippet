# Name: 蜻蜓FM去广告
# Description: 移除开屏广告、信息流广告、各类相关内容推荐，精简我的页面。
# Open URL: https://apps.apple.com/app/id506685538
# Author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Tags: 去广告
# Homepage: https://hub.kelee.one
# Icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/QtingFM.png
# Updated: 2026-10-02 13:57:49

# Converted: 2026-10-04 18:36:49 +08:00
# Converted by: chance
# Category: 去广告
# Source: https://kelee.one/Tool/Loon/Lpx/QtingFM_remove_ads.lpx
# Target: Quantumult X

# [filter_local]
host, ad.qtfm.cn, reject
host, adlaunch.qtfm.cn, reject

# [rewrite_local]
^https:\/\/app\.qtfm\.cn\/recommendapi\/v8\/ai_assistant_point$ url reject-dict

^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/signin\/show_homepage_icon$ url reject-dict

^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/emotion$ url reject

^https:\/\/search\.qtfm\.cn\/v\d\/keyword\/default$ url reject

^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/signin\/show_homepage_icon$ url jsonjq-response-body 'if (getpath(["data"]) | has("display_icon")) then (setpath(["data","display_icon"]; false)) else . end'

^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/hotpage\? url jsonjq-response-body '.data.head |= map(select(.type == "IconGrid")) | .data.feeds |= map(select(.type == "Channel" or .type == "Radio" or .type == "ListenListChannel"))'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/channel\/\d{6}\/playpage\/\d{8} url jsonjq-response-body 'delpaths([["data","related_recommend"],["data","recommend_bar"]])'

^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/user\/task\/play$ url reject-dict

^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/mylistenpage url jsonjq-response-body 'delpaths([["data","banner"]])'

^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/i_listen\/guess_you_like\? url reject-dict

^https:\/\/recpage-c\.qtfm\.cn\/v\d\/favorites$ url reject-dict

^https:\/\/user\.qtfm\.cn\/u\d\/api\/v\d\/user\/following_podcaster\? url reject-dict

^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/subscribed_channels\? url jsonjq-response-body 'delpaths([["data","recommends"]])'

^https:\/\/entry\.qtfm\.cn\/api\/v\d\/personal\/\?carrier url reject-dict

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
^https:\/\/app\.qtfm\.cn\/m-bff\/v1\/channelpage\/\d+$ url jsonjq-response-body 'delpaths([["data","vip_recommend"],["data","recommend_delivery"]])'

^https:\/\/search\.qtfm\.cn\/v3\/entry$ url reject-dict

^https:\/\/woqt2\.qtfm\.cn\/v2\/userConfig\? url reject-dict

# [mitm]
hostname = app.qtfm.cn, entry.qtfm.cn, recpage-c.qtfm.cn, user.qtfm.cn, search.qtfm.cn, woqt2.qtfm.cn
