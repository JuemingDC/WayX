[Rule]
AND,((DOMAIN-SUFFIX,xiaohongshu.com,extended-matching),(PROTOCOL,UDP)),REJECT
DOMAIN,ads-img-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-al.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,t-ads.xiaohongshu.com,REJECT,extended-matching,pre-matching

[Body Rewrite]

# 搜索页
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$ 'if (try (getpath([]) | has("data")) catch false) then setpath(["data"]; {}) else . end'
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$ 'if (try (getpath(["data"]) | has("items")) catch false) then setpath(["data","items"]; []) else . end'
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint 'if (try (getpath(["data"]) | has("hint_words")) catch false) then setpath(["data","hint_words"]; []) else . end'
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? '(. as $__wayx_before | try (if type == "object" then if (try (getpath(["data"]) | has("queries")) catch false) then setpath(["data","queries"]; []) else . end else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then if (try (getpath(["data"]) | has("hint_word")) catch false) then setpath(["data","hint_word"]; {}) else . end else . end) catch $__wayx_before)'

[Map Local]
# 小红书水印
^https:\/\/ci\.xiaohongshu\.com\/system_config\/watermark data-type=tiny-gif status-code=200

# 惊喜弹窗
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 信息流
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(?:v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

