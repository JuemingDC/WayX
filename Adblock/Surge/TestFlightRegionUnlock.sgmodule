#!name=TestFlight地区解锁
#!desc=解除TestFlight的区域限制，支持tvOS。
#!category=WayX
#!requirement=CORE_VERSION>=20
#!arguments=wayx_proxy_policy:DIRECT
#!arguments-desc=wayx_proxy_policy: Loon PROXY policy binding — default DIRECT; set to the desired Surge proxy policy or policy group

# Open URL: https://apps.apple.com/app/id899247664
# Author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Tags: 功能增强
# Homepage: https://hub.kelee.one
# Icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TestFlight.png
# Updated: 2026-10-02 13:57:49

# Converted: 2026-10-03 17:44:42 +08:00
# Converted by: chance
# Source: https://kelee.one/Tool/Loon/Lpx/TestFlightRegionUnlock.lpx
# Target: Surge

[Rule]
DOMAIN,testflight.apple.com,{{{wayx_proxy_policy}}}

[Body Rewrite]
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$ "storefrontId"\x20:\x20"\d{6}-\d{2},\d{2}", "storefrontId":"143441-19,29",

[MITM]
hostname = %APPEND% testflight.apple.com
