[Rule]
URL-REGEX,^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list,REJECT,extended-matching

AND,((DEST-PORT,18000),(PROTOCOL,STUN)),REJECT
DOMAIN,stun1.douyucdn.cn,REJECT,extended-matching,pre-matching
DOMAIN,stun1.qvb.qcloud.com,REJECT,extended-matching,pre-matching

[URL Rewrite]

^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) $1$5$6 307

[Body Rewrite]

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list '(. as $__wayx_before | try (if type == "object" then delpaths([["data","pendant_a"]]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then delpaths([["data","entrance_d"]]) else . end) catch $__wayx_before)'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config 'if type == "object" then if (try (getpath([]) | has("greatGodGameSitterSwitch")) catch false) then setpath(["greatGodGameSitterSwitch"]; 0) else . end else . end | if type == "object" then if (try (getpath([]) | has("followMoreAnchorEntrance")) catch false) then setpath(["followMoreAnchorEntrance"]; 0) else . end else . end | if type == "object" then if (try (getpath([]) | has("sdklivebanner")) catch false) then setpath(["sdklivebanner"]; 0) else . end else . end | if type == "object" then if (try (getpath([]) | has("homeActFloatSwitch")) catch false) then setpath(["homeActFloatSwitch"]; 0) else . end else . end | if type == "object" then if (try (getpath([]) | has("bringGoodsSwitch")) catch false) then setpath(["bringGoodsSwitch"]; 0) else . end else . end | if type == "object" then if (try (getpath([]) | has("qqGameSwitch")) catch false) then setpath(["qqGameSwitch"]; 0) else . end else . end'

[Map Local]
^https:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除首页轮播图和视频流广告 = type=http-response,pattern=^https:\/\/apiv2\.douyucdn\.cn\/mgapi\/livenc\/home\/getRecV3,script-path=https://kelee.one/Resource/JavaScript/Douyu/Douyu_remove_ads.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
