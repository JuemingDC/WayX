[Body Rewrite]
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'del(.data.function_configs.startup_ad_switch,.data.function_configs.startup_ad_timeout,.data.function_configs.startup_ad_day_max,.data.function_configs.app_bar_guide_width,.data.function_configs.app_bar_guide_height,.data.function_configs.app_bar_guide_url,.data.function_configs.app_bar_guide_time,.data.function_configs.home_tab_event_tag,.data.function_configs.home_tab_event_tag_ext,.data.function_configs.home_tab_player_tag,.data.function_configs.home_tab_player_tag_ext,.data.function_configs.task_center_entrance,.data.function_configs.store_go,.data.function_configs.wall_closed)'

http-response-jq ^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ 'del(.data.float_advertise)'

http-response-jq ^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ 'del(.data.placeholder)'

[Map Local]

^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
