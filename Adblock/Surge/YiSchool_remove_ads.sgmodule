[Body Rewrite]

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/compus\.xiaofubao\.com\/compus\/user\/getUserExt$ '(. as $__wayx_before | try (if type == "object" then delpaths([["data","adPopSwitch"]]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then delpaths([["data","adSplashSwitch"]]) else . end) catch $__wayx_before)'

http-response-jq ^https:\/\/compus\.xiaofubao\.com\/compus\/application\/getHomeAppList$ '.rows|=map(select(.appCode=="kechengbiao_app1" or .appCode=="siliuji" or .appCode=="NEWJIAOFEIDATING"))'

[Map Local]
^https:\/\/compus\.xiaofubao\.com\/compus\/advertising\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% compus.xiaofubao.com
