#!name=WPS每日签到
#!desc=WPS每日签到并兑换会员，需要进入此插件的主页链接，阅读使用说明操作。
#!category=WayX
#!requirement=CORE_VERSION>=22
#!arguments=CaptureCookie:false,AK:,SK:,DAY:1,MAX_RETRIES:5,CRONEXP:0 8 * * *
#!arguments-desc=CaptureCookie: 捕获Cookie — true/false — 此开关控制插件是否捕获Cookie\nAK: 百度API Key — 这里需要输入有效的百度API Key\nSK: 百度Secret Key — 这里需要输入有效的百度Secret Key\nDAY: 兑换天数 — 每日签到时自动兑换的天数，可不做更改。\nMAX_RETRIES: 失败重试次数 — 仅允许填写阿拉伯数字\nCRONEXP: 定时参数 — 这里需要输入符合CRON表达式的参数

# Open URL: https://apps.apple.com/app/id599852710
# Author: 小白脸
# Tags: 签到
# Homepage: https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/WPS/README.md
# Icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/WPS.png
# Updated: 2026-10-02 13:57:49

# Converted: 2026-10-04 00:55:40 +08:00
# Converted by: chance
# Source: https://kelee.one/Tool/Loon/Lpx/WPS_checkin.lpx
# Target: Surge

[Script]
#!REQUIREMENT "'{{{CaptureCookie}}}'=='true'" 捕获Cookie = type=http-request,pattern=^https:\/\/moapi\.wps\.cn\/app\/ios\/v1\/app$,script-path=https://kelee.one/Resource/JavaScript/WPS/WPS_checkin.js,requires-body=true,max-size=-1

WPS每日签到 = type=cron,cronexp="{{{CRONEXP}}}",script-path=https://kelee.one/Resource/JavaScript/WPS/WPS_checkin.js,timeout=120,argument="{\"AK\":\"{{{AK}}}\",\"SK\":\"{{{SK}}}\",\"MAX_RETRIES\":\"{{{MAX_RETRIES}}}\"}"

[MITM]
hostname = %APPEND% moapi.wps.cn
