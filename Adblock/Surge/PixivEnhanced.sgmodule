# Updated: 2026-10-03 16:00
# Version: 4.5.2

# Converted: 2026-10-04 18:37:14 +08:00
# Converted by: chance
# Source: https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/loon/PixivEnhanced.plugin
# Target: Surge

[URL Rewrite]
# 1. 劫持 Pixiv App 内「帮助中心」与「服务条款」，一键直达增强设置中心
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ https://app-api.pixiv.net/settings/Enhanced 302

[Map Local]

# 2. 原生级增强设置中心 (0ms 离线瞬时秒开，对标 Pix-Scripting 与 iOS 原生视觉规范)
^https:\/\/app-api\.pixiv\.net\/settings\/Enhanced(?:\?[^#]*)?$ data-type=file data="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/settings.html?v=202610031600" status-code=200 header="Content-Type:text/html|Cache-Control:no-store"

[Script]
# 设置中心与 API 交互及漫画查看器 (配置读取、保存、实时测速、清空缓存，支持 www.pixiv.net 原生点击弹窗)
Pixiv.Enhanced.SettingsAPI = type=http-request,pattern=^https:\/\/(app-api|www)\.pixiv\.net\/(settings\/Enhanced|manga\/viewer|api\/),script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/pixiv_enhanced.js?v=202610031600,requires-body=true,max-size=-1

# 全页面 REST API 响应体汉化拦截器（全覆盖首页home/推荐/榜单/详情/评论v3/画师主页/特辑/漫画/小说/冷启动流）
Pixiv.Enhanced.ApiTranslate = type=http-response,pattern=^https:\/\/app-api\.pixiv\.net\/v[1-3]\/(illust|manga|novel|user|search|trending-tags|spotlight|home|walkthrough),script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/pixiv_enhanced.js?v=202610031600,requires-body=true,max-size=-1

# 小说阅读器 & 页面注入 iOS SF Symbols「文/A」悬浮按钮与排版引擎
Pixiv.Enhanced.WebviewInject = type=http-response,pattern=^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/pixiv_enhanced.js?v=202610031600,requires-body=true,max-size=-1

# 翻译中转网关与 AI 视觉漫翻端点
Pixiv.Enhanced.Proxy = type=http-request,pattern=^https:\/\/(app-api|www)\.pixiv\.net\/pxtrans,script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/pixiv_enhanced.js?v=202610031600,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% app-api.pixiv.net, app.pixiv.help, policies.pixiv.net, www.pixiv.net
