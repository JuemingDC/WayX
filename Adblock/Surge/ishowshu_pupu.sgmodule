[Rule]
# Name: 朴朴超市
# Updated: 2026-10-25 18:31:42 +08:00
# Merged by: chance
# Source Authors: 树先生, 可莉
# Category: app
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/pupu.snippet
# Upstream name = 朴朴超市
# Upstream author = 树先生, 可莉
# Upstream desc = 移除广告，沉浸买菜
# 广告下发
# Source declaration: ^http:\/\/139\.196\.12\.179:8053\/httpdns\/ url REJECT
# Source declaration: ^http:\/\/106\.55\.220\.18:8053\/httpdns\/ url REJECT
# Source declaration: ^http:\/\/54\.222\.159\.138:8053\/httpdns\/ url REJECT
# Source declaration: ^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ url REJECT
# 主页实惠卡横幅
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my url REJECT
# 搜索框页面热榜
# 朴朴超市订单待收货页右下角悬浮广告
# 购物车页去换购推荐
# 各种页面的商品推荐
# 个人主页会员标识
# 消息中心促销消息未读提示
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number url jsonjq-response-body .data = []
# 搜索热词
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 url jsonjq-response-body .data = []
# 搜索结果页信息流横幅广告
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6 url jsonjq-response-body .data.feed_banner_cards = []
# 下单页实惠卡开通推荐
# Source declaration: ^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail url jsonjq-response-body .data.member_card_v2 = []
# 开屏广告、首页横幅等
# 订单列表骑手反馈问题推荐
# Upstream hostname = j1.pupuapi.com

[URL Rewrite]
^http:\/\/139\.196\.12\.179:8053\/httpdns\/ _ reject
^http:\/\/106\.55\.220\.18:8053\/httpdns\/ _ reject
^http:\/\/54\.222\.159\.138:8053\/httpdns\/ _ reject
^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ _ reject
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/index\/my _ reject

[Map Local]
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/hub\/camel\/search_input_ranking data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number '.data = []'
http-response-jq ^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 '.data = []'
http-response-jq ^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6 '.data.feed_banner_cards = []'
http-response-jq ^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail '.data.member_card_v2 = []'

[Script]
ishowshu_pupu_1 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/pp.js,requires-body=true
ishowshu_pupu_2 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/order\/orders\/list\/v4,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/pp.js,requires-body=true

[MITM]
hostname = %APPEND% j1.pupuapi.com
