# Icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/bilibili.png
# Icon Collection: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/ligeicon.json
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: 哔哩哔哩
# Updated: 2026-10-30 15:52:20 +08:00
# Merged by: chance
# Source Authors: 树先生, kokoryh
# Category: app
# Managed by: WayX Native QX
DOMAIN,app.biliapi.net,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.com,REJECT
#AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT
# 开屏广告
# 首页视频信息流
# 首页顶部右边图标、导航栏列表、底部tab栏目
# 搜索页推荐
# 首页右上角活动小图标
# 我的页面简化
# 直播相关净化
# 直播tab页面在选择标签后的banner
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/bilibili-qx.snippet
# Upstream name = 哔哩哔哩
# Upstream desc = B站去广告
# Upstream author = kokoryh, 树先生
# Upstream hostname = app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com

[Map Local]
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/ap[ip]\.bilibili\.com\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'

[Script]
ishowshu_bilibili_1 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_2 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_3 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_4 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\?,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_5 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_6 = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true
ishowshu_bilibili_7 = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/second\/getList,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/bilibili-ad.js,requires-body=true

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com
