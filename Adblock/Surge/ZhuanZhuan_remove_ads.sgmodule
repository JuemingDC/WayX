http-response-jq ^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\? '(. as $__wayx_before | try (if type == "object" then delpaths([["respData","topOpera","leftOpera"]]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then delpaths([["respData","topOpera","rightOpera2"]]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then delpaths([["respData","topActBanner"]]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then delpaths([["respData","bmArea"]]) else . end) catch $__wayx_before)'

