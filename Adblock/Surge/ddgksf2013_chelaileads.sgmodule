^https?:\/\/124\.70\.194\.16\/(ip|adpub) data-type=text data="" status-code=200
^https?:\/\/124\.70\.194\.16\/goocity\/flowPos\/listByPos data-type=text data="" status-code=200
^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow data-type=text data="" status-code=200
^https?:\/\/atrace\.chelaile\.net\.cn\/(wx_preloadAd|adAnalysis) data-type=text data="" status-code=200

[Script]
ddgksf2013_chelaileads_1 = type=http-response,pattern=^https?:\/\/.*chelaile\.net\.cn\/goocity\/city!,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/e5c5def3fc5ea2b2648759d0a31862b655d9eb650f39d385d5d2a968dcb66717/chelaile.js,requires-body=true

[MITM]
