# Source declaration: https://acs.m.taobao.com/gw/mtop.film.life.aristotle.get url jsonjq-response-body '.data.nodes[]?.nodes |= map(select(.data.componentId | IN("tpp_banner_loop", "tpp_guess_like") | not))'
