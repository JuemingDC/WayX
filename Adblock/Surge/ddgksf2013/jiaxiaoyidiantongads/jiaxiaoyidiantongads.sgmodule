[URL Rewrite]
^https?:\/\/vip\.zeusai\.xin\/api\/adx _ reject
^https?:\/\/richmanrules\.ksedt\.com\/serverConfig _ reject
^https?:\/\/gw-api\.jxedt\.com\/app\/config.*homead _ reject
^https?:\/\/richmanrules\.ksedt\.com\/intellectWaterfall\/find _ reject
^https?:\/\/richmanrules\.ksedt\.com\/intellectWaterfallBidding\/find _ reject

[Body Rewrite]
http-response-jq ^https?:\/\/api\.ksedt\.com\/appSearch\/getDefaultWord '.result={}'

[MITM]
hostname = %APPEND% richmanrules.ksedt.com, api.ksedt.com, gw-api.jxedt.com, vip.zeusai.xin
