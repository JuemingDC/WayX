[Rule]
# Name: V2ex网页
# Updated: 上游未标注
# Copied by: chance
# Source Authors: ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://ddgksf2013.top/scripts/v2ex.ads.js
# *********************************
# 墨鱼自用V2EX网页去广告
# 2026-07-07
# https://t.me/ddgksf2021
# *********************************

[Map Local]
^https?:\/\/pagead.*googlesyndication\.com\/pagead data-type=text data="" status-code=200
^https?:\/\/.*v2ex\.com\/pro\/emitter data-type=text data="" status-code=200

[Script]
ddgksf2013_v2ex-ads_1 = type=http-response,pattern=^https?:\/\/.*v2ex\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/v2ex-ads/v2ex.ads.js,requires-body=true

[MITM]
hostname = %APPEND% *.v2ex.com, pagead*.googlesyndication.com
