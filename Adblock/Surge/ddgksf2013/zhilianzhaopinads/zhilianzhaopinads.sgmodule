[URL Rewrite]
^https?:\/\/cgate\.zhaopin\.com\/behavior\/nps\/getNpsPopupList _ reject
^https?:\/\/cgate\.zhaopin\.com\/operation\/ad\/ _ reject
^https?:\/\/cgate\.zhaopin\.com\/marketbusiness\/ad\/ _ reject
^https?:\/\/223\.5\.5\.5\/resolve _ reject
^https?:\/\/cgate\.zhaopin\.com\/campusbusiness\/.*getAdvertisement _ reject
^https?:\/\/cgate\.zhaopin\.com\/bdp\/tips-calc\/getSchoolHomePageTips _ reject

[Body Rewrite]
http-response-jq ^https?:\/\/cgate\.zhaopin\.com\/bdp\/my\/homepageMainModule 'del(.data.commercialModule, .data.commercialModuleV5, .data.vipModule, .data.vipModuleCardNew)'

[MITM]
hostname = %APPEND% cgate.zhaopin.com
