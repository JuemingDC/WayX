#!name=Zaker净化[墨鱼版]
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# WayX ID: AD0402
# Native QX review count: 0

[Rule]
# Name: Zaker净化[墨鱼版]
# Updated: 2026-11-1
# Copied by: chance
# Source Authors: ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://ddgksf2013.top/rewrite/ZakerAds.conf
// ==UserScript==
// @ScriptName        Zaker净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @Feedback          📮 ddgksf2013@163.com 📮
// @UpdateTime        2026-11-1
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.3
// @ScriptURL         https://ddgksf2013.top/rewrite/ZakerAds.conf
// ==/UserScript==

[Body Rewrite]
http-response-jq ^https:\/\/iphone\.myzaker\.com\/zaker\/cover\.php '.data.cover_ads = {}'
http-response-jq ^https:\/\/ggs\.myzaker\.com\/zk_block_ad\.php '.data |= (del(.tofu_partner_ad) | with_entries(if (.key as $k | ["ad_list","pic_ad_list","ad_position","pic_ad_position","ad_position_integration","pic_ad_position_integration"] | index($k)) != null then .value = [] else . end))'
http-response-jq ^https:\/\/ggs\.myzaker\.com\/zk_recommend_ad\.php '.data.ad_list = [] | .data.ad_position_integration = [] | del(.data.partner_ad)'
http-response-jq ^https?:\/\/search\.myzaker\.com\/api\/\?(?:[^&]*&)*c=keywords(&|$) 'if (.data.wordlist? | type) == "array" then .data.wordlist |= map(select(.pk != "hotwords" and .pk != "keywords")) else . end'

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com, search.myzaker.com
