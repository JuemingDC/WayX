[Rule]
# Name: 咪咕视频净化[墨鱼版]
# Updated: 2026-02-14
# Copied by: chance
# Source Authors: ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://ddgksf2013.top/rewrite/MiGuVideoAds.conf
// ==UserScript==
// @ScriptName        咪咕视频净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2026-02-14
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.3
// @ScriptURL         https://ddgksf2013.top/rewrite/MiGuVideoAds.conf
// ==/UserScript==

[Map Local]
https://.*miguvideo\.com\/request\/sdk data-type=text data="" status-code=200
https://.*miguvideo\.com\/deliver\/site\/batchMatch\/mergeSpot\/miguvideo data-type=text data="" status-code=200

[Body Rewrite]
http-response-jq https://.*miguvideo\.com\/recommend-dynamic\/dataSource\/v\d\/recommend '.body.data=[]'
http-response-jq https://.*migu\.cn\/search\/hotword '.body={}'

[Script]
ddgksf2013_miguvideoads_1 = type=http-response,pattern=https://.*miguvideo\.com\/app-management\/v\d\/staticcache\/navigation-list\/miguvideo\/ios,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/miguvideoads/migu.ads.js,requires-body=true
ddgksf2013_miguvideoads_2 = type=http-response,pattern=https://.*miguvideo\.com\/display\/v\d\/static\/PERSONAL_CENTER,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/miguvideoads/migu.ads.js,requires-body=true

[MITM]
hostname = %APPEND% *.miguvideo.com, *.migu.cn
