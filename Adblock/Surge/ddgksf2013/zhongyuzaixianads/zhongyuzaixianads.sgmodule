#!name=中羽在线净化[墨鱼版]
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: 中羽在线净化[墨鱼版]
# Updated: 2026-08-18
# Copied by: chance
# Source Authors: ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://ddgksf2013.top/rewrite/ZhongYuZaiXianAds.conf
// ==UserScript==
// @ScriptName        中羽在线净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @Feedback          📮 ddgksf2013@163.com 📮
// @UpdateTime        2026-08-18
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.5
// @ScriptURL         https://ddgksf2013.top/rewrite/ZhongYuZaiXianAds.conf
// ==/UserScript==
# > 开屏 / 首页浮窗 / 轮播 Banner / 弹窗
# > 首页轮播组件
# > 信息流广告
# > 我页中羽小店 / 推广 / 红包 / 优惠券
# > 社区商业街
# > 中羽助手推广消息
# > 发现页网页广告 iframe
# > 网页广告内容
# > SDK 监控上报

[Map Local]
^https:\/\/app\.badmintoncn\.com\/mag\/config\/v\d+\/iframe\/iframeView\?id=13 data-type=text data="" status-code=200
^https:\/\/www\.badmintoncn\.com\/cboa\.php data-type=text data="" status-code=200
^https:\/\/pc-mon\.snssdk\.com\/monitor_pc\/collect\/api\/pc_log data-type=text data="" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/operative\/v1\/ad\/listNotEndByPlace '.list=[]'
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/info\/v\d+\/channel\/channelConfigById '.data.operative_config=((.data.operative_config // []) | map(select(._type!="pic_slide")))'
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/info\/v\d+\/(?:channel|info)\/infoListByCatId '.list=((.list // []) | map(select(._type!="pic_ad")))'
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/user\/v\d+\/user\/myCenter '.list=((.list // []) | map(select(.name!="中羽小店")) | map(if .title=="我的权益" then .items=((.items // []) | map(select(.title!="我的推广" and .title!="每日红包" and .title!="优惠券"))) else . end))'
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/circle\/v\d+\/Circle\/circleRecommend '.tops=((.tops // []) | map(select(.name!="中羽商业街")))'
http-response-jq ^https:\/\/app\.badmintoncn\.com\/mag\/operative\/v\d+\/assistant\/pullAssistantMsg '.list=((.list // []) | map(select((((.content | tostring) | contains("cbo_gg/count.php")) == false))))'

[MITM]
hostname = %APPEND% app.badmintoncn.com, www.badmintoncn.com, pc-mon.snssdk.com
