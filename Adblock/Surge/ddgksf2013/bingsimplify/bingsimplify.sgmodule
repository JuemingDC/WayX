#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: Bing首页简化[墨鱼版]
# Updated: 2023-12-18
# Copied by: chance
# Source Authors: 墨鱼 / ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/BingSimplify.conf
// ==UserScript==
// @ScriptName        Bing首页简化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2023-12-18
// @Suitable          自行观看“# > ”注释内容[请卸载重装]
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.4
// @ScriptURL         https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/BingSimplify.conf
// ==/UserScript==
# > bing_首页优化@ddgksf2013
# > bing_位置请求@ddgksf2013
# > bing_信息流@LE
# > bing_天气请求@ddgksf2013

[Map Local]
^https?:\/\/assets\.msn\.com\/service\/weather\/locations\/search data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/assets\.msn\.com\/service\/news\/feed\/pages\/startmhp data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api\.msn\.com\/weather data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ddgksf2013_bingsimplify_1 = type=http-response,pattern=^https?:\/\/sapphire\.api\.microsoftapp\.net\/config\/api\/v1\/get,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bingsimplify/bing.js,requires-body=true

[MITM]
hostname = %APPEND% sapphire.api.microsoftapp.net, assets.msn.com, api.msn.com
