#!name=微信阅读精简
#!desc=去除微信阅读扰人提示(beta)
#!category=WayX
# 测试环境： 1.关闭微信阅读通知；2.禁止微信阅读获取微信好友权限
# 功能：1.去除底部小红点提示；2.去除阅读页面小圈子提示；3.去除阅读页面评论、分享等数字

[Script]
WeRead = type=http-response,pattern=https:\/\/i\.weread\.qq\.com\/(book\/(reading[sS]tat|chapterReview)|user\/profile|groups\/readerEntrance|review\/list|mobileSync),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/weread/weread.js

[MITM]
hostname = %APPEND% i.weread.qq.com
