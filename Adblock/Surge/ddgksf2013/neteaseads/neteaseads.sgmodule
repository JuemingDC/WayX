[Map Local]
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list data-type=text data="" status-code=200
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query data-type=text data="" status-code=200
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get data-type=text data="" status-code=200
^https?:\/\/interface(\d)?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity data-type=text data="" status-code=200
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources data-type=text data="" status-code=200
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/resource-exposure\/config data-type=text data="" status-code=200

