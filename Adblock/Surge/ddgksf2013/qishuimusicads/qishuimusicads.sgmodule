#!name=汽水音乐净化[墨鱼版]
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: 汽水音乐净化[墨鱼版]
# Updated: 2025-09-26
# Copied by: chance
# Source Authors: 墨鱼 / ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/QiShuiMusicAds.conf
// ==UserScript==
// @ScriptName        汽水音乐净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2025-09-26
// @Suitable          自行观看“# > ”注释内容
// @Attention         使用前请卸载汽水音乐，挂载脚本然后使用
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.6
// @ScriptURL         https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/QiShuiMusicAds.conf
// ==/UserScript==
# > 视频广告@ddgksf2013
# > 通用广告@ddgksf2013
# > 位置隐私@ddgksf2013
# > 广告弹窗@ddgksf2013
# > TAGS推荐@ddgksf2013
# > 我的页面推广@ddgksf2013
# > 会员免费听整月VIEW@ddgksf2013
# > 热门搜索@ddgksf2013
# > DNS处理@ddgksf2013
# > 搜索界面活动@ddgksf2013
# > 音乐流推广@ddgksf2013

[Map Local]
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/media_ads data-type=text data="" status-code=200
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads data-type=text data="" status-code=200
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info data-type=text data="" status-code=200
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/commerce data-type=text data="" status-code=200
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend data-type=text data="" status-code=200
^https:\/\/tnc.*zijieapi\.com\/get_domains data-type=text data="" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/me\? 'del(.reward_ad_banner)'
http-response-jq ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/card 'del(.preview_guide)'
http-response-jq ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/search-block 'del(.search_chart_block)'
http-response-jq ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/activities 'del(.activity_map)'
http-response-jq ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/feed\/song-tab '.items |= map(select(.type == "track"))'

[MITM]
hostname = %APPEND% beta-luna.douyin.com, api.qishui.com, tnc*-*.zijieapi.com
