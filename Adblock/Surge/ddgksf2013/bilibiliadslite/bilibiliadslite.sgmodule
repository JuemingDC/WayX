// ==UserScript==
// @ScriptName        哔哩哔哩广告净化[残缺版]
// @Desc              残缺版B站去广告
// @Author            @ddgksf2013
// @FanjuChuChai      https://space.bilibili.com/11783021/
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2026-01-17
// @Attention         如果广告仍然存在，请清除缓存或卸载应用重新安装
// @Attention         如需引用请注明出处，谢谢合作！
// @ScriptURL         https://ddgksf2013.top/rewrite/BiliBiliAdsLite.conf
// ==/UserScript==

[Map Local]
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show data-type=text data="" status-code=200

[Script]
ddgksf2013_bilibiliadslite_1 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_2 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_3 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_4 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_5 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_6 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true
ddgksf2013_bilibiliadslite_7 = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/search\/square,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/bilibiliadslite/bilibili.ads.js,requires-body=true

[MITM]
hostname = %APPEND% app.bilibili.com
