[Rule]
# Name: 中国移动
# Updated: 上游未标注
# Copied by: chance
# Source Authors: Yuheng
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/Yuheng0101/X/refs/heads/main/Scripts/ChinaMobile/NoAds.js
# ****************************************
# @name 广告移不动
# @description 去除肉眼可见的广告
# @channel https://t.me/yqc_123
# @feedback https://t.me/lanjieguanggao
# @version 1.0.0
# *****************************************
# 脚本声明:
# 1. 本脚本仅用于学习研究，禁止用于商业用途
# 2. 本脚本不保证准确性、可靠性、完整性和及时性
# 3. 任何个人或组织均可无需经过通知而自由使用
# 4. 作者对任何脚本问题概不负责，包括由此产生的任何损失
# 5. 如果任何单位或个人认为该脚本可能涉嫌侵犯其权利，应及时通知并提供身份证明、所有权证明，我将在收到认证文件确认后删除
# 6. 请勿将本脚本用于商业用途，由此引起的问题与作者无关
# 7. 本脚本及其更新版权归作者所有
# *****************************************
# 特别说明:
# 由于App内大部分活动都使用web-view嵌入H5的形式且链接不定, 故不对内部活动进行相关广告去除。
# *****************************************
# 启动页
# 首页 - 下拉
# 首页 - 悬浮广告
# 弹窗
# 办理 - 横幅
# 我的 - 弹窗
# ****************************************

[Map Local]
^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/popupWindow\/getDetail data-type=text data="" status-code=200

[Script]
ddgksf2013_noads_1 = type=http-response,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true
ddgksf2013_noads_2 = type=http-response,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/newTopPullSecond\/getNewTopPullList,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true
ddgksf2013_noads_3 = type=http-response,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/emotionMarket\/getEmotionMarketNew,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true
ddgksf2013_noads_4 = type=http-response,pattern=^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/homeArea\/getTopAreaList,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true
ddgksf2013_noads_5 = type=http-response,pattern=^https?:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/navigation\/getNavigationNewInfo,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true
ddgksf2013_noads_6 = type=http-response,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/friendShake\/getShakeList,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/noads/NoAds.js,requires-body=true

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, h.app.coc.10086.cn
