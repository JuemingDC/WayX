// ==UserScript==
// @ScriptName        威锋净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @Feedback          📮 ddgksf2013@163.com 📮
// @UpdateTime        2026-06-06
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.3
// @ScriptURL         https://ddgksf2013.top/rewrite/WeiFengAds.conf
// ==/UserScript==

[Map Local]
^https?:\/\/api\.wfdata\.club\/v\d\/yesfeng\/(infoCenterAd|yesList) data-type=text data="" status-code=200
^https?:\/\/api\.wfdata\.club\/v\d\/content\/home_insert data-type=text data="" status-code=200

[Body Rewrite]
http-response-jq ^https?:\/\/api\.wfdata\.club\/v\d\/user\/homePageInfo '.data.userBaseInfo.isVip = true|.data.userBaseInfo.vipExpiryDate = "2029-12-31" '

[MITM]
hostname = %APPEND% api.wfdata.club
