[Rule]
# Name: 腾讯视频净化
# Updated: 上游未标注
# Copied by: chance
# Source Authors: ZenmoFeiShi
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TxvideoAD.snippet
# Upstream name = 腾讯视频净化
# Upstream author = TG@ZenMoFiShi
# Upstream update = 2026-11-03
# Upstream desc = 去除开屏广告、视频播放前广告、底部的多余 tap 栏、我的页面美化、我的界面顶部广告
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
ddgksf2013_txvideoad_1 = type=http-request,pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/txvideoad/Txvideoad.js,requires-body=true,binary-body-mode=true
ddgksf2013_txvideoad_2 = type=http-response,pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/txvideoad/Txvideoad.js,requires-body=true,binary-body-mode=true
ddgksf2013_txvideoad_3 = type=http-response,pattern=^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/txvideoad/Txvideoad.js,requires-body=true,binary-body-mode=true
ddgksf2013_txvideoad_4 = type=http-response,pattern=^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/txvideoad/Txvideoad.js,requires-body=true,binary-body-mode=true
ddgksf2013_txvideoad_5 = type=http-response,pattern=^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ddgksf2013/txvideoad/Txvideoad.js,requires-body=true,binary-body-mode=true

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
