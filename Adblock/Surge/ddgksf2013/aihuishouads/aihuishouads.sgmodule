#!name=爱回收净化[墨鱼版]
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# WayX ID: AD0008
# Native QX review count: 0

[Rule]
# Name: 爱回收净化[墨鱼版]
# Updated: 2026-07-26
# Copied by: chance
# Source Authors: ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://ddgksf2013.top/rewrite/AiHuiShouAds.conf
// ==UserScript==
// @ScriptName        爱回收净化[墨鱼版]
// @Author            @ddgksf2013
// @Function          如果有需要的去除广告的APP，可自行在共享表格中添加需求
// @AddRequest        https://bit.ly/addRequestforAdBlock
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @Feedback          📮 ddgksf2013@163.com 📮
// @UpdateTime        2026-07-26
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.3
// @ScriptURL         https://ddgksf2013.top/rewrite/AiHuiShouAds.conf
// ==/UserScript==
# > 开屏广告配置
# > 首页 / 我的页场景弹窗
# > 首页配置：去福利中心、首页二楼、运营 Banner、营销 Slogan
# > 首页产品轮播 / 优惠券提示
# > 福利中心：新人礼包、活动弹窗、返现、任务奖励
# > 加价 / 超级补贴活动
# > 个人中心配置：去活动 Banner、福利中心、口令兑换、门店加盟等
# > 严选首页：广告 Banner
# > 严选频道 Banner
# > 搜索框推荐词
# > 发现页 / 活动 Tab
# > 底栏营销 / 活动入口
# > 任务中心入口 / 气泡提示
# > 未登录引导浮窗
# > 通用配置：登录页新人红包、购物车头图、促销弹窗
# > 门店页营销标签
# > 我的页更多功能：保留常用功能
# > 会员中心营销图片 / 弹窗
# > AB 实验：关闭微信广告实验
# > 埋点 / Sentry / 探针

[Map Local]
^https:\/\/bi-log\.aihuishou\.com\/trace\/log\/ahs data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/ahs-sentry\.aihuishou\.com\/api\/\d+\/envelope\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/wirelessgate\.aihuishou\.com\/garage-versional\/sniffer data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/search-config '.data=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dammam-service\/api\/scene-message-template\/pull '.data.statusCode=1 | .data.params={} | .data.context={} | .data.templateId=0 | .data.eventName=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/config-renew-v3 '.data.promotionBannerConfigs=[] | .data.homeSecondFloorBanner=[] | .data.yanxuanSlogan=null | .data.recycleSlogan=null'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/my-product-rotate-v2 '.data.myProductCoupon={"receivableCouponCount":0,"receivableCouponList":[],"userCouponCount":0,"couponPrice":0,"couponCondition":0} | .data.otherCategoriesImg=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/welfare-center\/entry-v2 '.data.pop=false | .data.receiveStatus=0 | .data.couponPackages=[] | .data.cashBacks=null | .data.taskBonus=null | .data.totalAwardPrice=0 | .data.homeWelfareZone=null | .data.notLoginPopup=null | .data.bgImageUrl=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/activity\/gradient-increase-sniff-v2 '.data.items=[] | .data.matchedPolicyItem=null | .data.nextPolicyItem=null | .data.inquiryItems=[] | .data.illustrate=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/module-config-v2 '.data.userCenterAflBanner=null | .data.userCenterLinLiBanner=null | .data.userCenterBottomBanners=[] | .data.activityCarouselMap=[] | .data.inviteNewUserActivity=null | .data.userCenterCommonFunctions=((.data.userCenterCommonFunctions // []) | map(select(.title!="福利中心" and .title!="口令兑换" and .title!="门店加盟")))'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/products\/home\/config '.data.adBannerList=null | .data.categoryAdBannerList=[] | .data.adBannerImgList=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/channel\/banner '.data.flowBannerList=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/search\/placeholders-v2 '.data=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/find-tab-v4 '.data=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/navbar-v7 '.data=((.data // []) | map(select(.type!=8 and .type!=9 and .type!=10)))'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/task-center\/show-entrance '.data.showEntrance=false | .data.unclaimedAmount=0 | .data.expireAmount=null | .data.secondsUntilExpired=null | .data.timeLimitTask=false | .data.showWaitComment=false | .data.fissionBubble=null'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/float-layers\/guide-login-v2 '.data.id=0 | .data.name="" | .data.interactionMethod=0 | .data.commonLink=null | .data.couponPackageCode=null | .data.imgUrl=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/commonConfig '.data.loginPageConfig.loginNewCouponTips="" | .data.loginPageConfig.loginNewCouponTipsImg="" | .data.loginPageConfig.loginBannerUrl="" | .data.cartHeaderImage="" | .data.promotionCenter.popup=false | .data.promotionCenterV2.popup=false | .data.promotionCenterV2.popupImg="" | .data.promotionCenterV2.popupButtonImg="" | .data.tradeRelievedRecycleAdvantageImage=""'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/shops\/service-station-list-v7 '.data.customerTagConfig=[]'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config-center\/search-project '.data=((.data // []) | map(select(.name=="附近回收机" or .name=="附近门店" or .name=="手机维修" or .name=="帮助中心")))'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/member\/static-config '.data.memberUserCenter={} | .data.memberWelfareCenter={} | .data.couponTagImgUrl="" | .data.memberInquiry.popTitleImageUrl="" | .data.memberInquiry.popBgImageUrl="" | .data.memberInquiry.popCoupon={}'
http-response-jq ^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/gemini\/grouping '.data=((.data // []) | map(if .name=="wechat_advertisement" then .group=0 else . end))'

[MITM]
hostname = %APPEND% dubai-app.aihuishou.com, dubai.aihuishou.com, bi-log.aihuishou.com, ahs-sentry.aihuishou.com, wirelessgate.aihuishou.com
