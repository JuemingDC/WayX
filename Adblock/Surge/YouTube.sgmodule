#!name=YouTube
#!desc=移除广告。
#!category=WayX
#!arguments=blockImmersive:false,blockShorts:false,blockUpload:false,debug:false,captionLang:zh-Hans
#!arguments-desc=blockImmersive: 隐藏选段按钮 — true/false — 用于隐藏YouTube Music底栏的选段按钮\nblockShorts: 隐藏短片按钮 — true/false — 用于隐藏YouTube Shorts按钮\nblockUpload: 隐藏上传按钮 — true/false — 用于隐藏YouTube底栏的上传按钮\ndebug: 启用调试模式 — true/false — 此插件的调试模式\ncaptionLang: 字幕翻译语言 — options=zh-Hans|zh-Hant|ja|ko|en|off — 需要把YouTube字幕翻译翻译为何种语言

# Author: Maasea[https://github.com/Maasea/sgmodule], RuCu6[https://github.com/RuCu6]
# Icon: https://rucu6.pages.dev/Icons/app/youtube.png
# Updated: 2026-08-30 10:10

# Converted: 2026-10-01 15:14:31 +08:00
# Converted by: chance
# Source: https://rucu6.pages.dev/Plugins/youtube.lpx
# Target: Surge

[Rule]
#AND, ((DOMAIN, youtubei.googleapis.com), (PROTOCOL, UDP)), REJECT
#AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, UDP)), REJECT

[URL Rewrite]
# loon 专用写法
# youtube 短链移除追踪参数
(^https:\/\/youtu\.be\/[\w-]+)(?:\?si=\w+) $1 302

[Map Local]
#response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "", 200)
# ^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\? data-type=text data="" status-code=200 header="Content-Type:text/plain"

[Script]
youtube_request_init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,script-path=https://rucu6.pages.dev/Scripts/youtube/request.js,requires-body=true,max-size=-1,binary-body-mode=true,argument="{\"captionLang\":\"{{{captionLang}}}\"}"
youtube_request_log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,script-path=https://rucu6.pages.dev/Scripts/youtube/request.js,requires-body=true,max-size=-1,binary-body-mode=true
youtube_response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,script-path=https://rucu6.pages.dev/Scripts/youtube/response.js,requires-body=true,max-size=-1,binary-body-mode=true,argument="{\"blockImmersive\":{{{blockImmersive}}},\"blockShorts\":{{{blockShorts}}},\"blockUpload\":{{{blockUpload}}},\"debug\":{{{debug}}},\"captionLang\":\"{{{captionLang}}}\"}"

[MITM]
hostname = %APPEND% rr*.googlevideo.com, youtu.be, youtubei.googleapis.com
