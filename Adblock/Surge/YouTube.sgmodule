#!name=YouTube
#!desc=移除广告。

# Author: Maasea[https://github.com/Maasea/sgmodule], RuCu6[https://github.com/RuCu6]
# Icon: https://rucu6.pages.dev/Icons/app/youtube.png
# Updated: 2026-08-30 10:10

# Converted: 2026-09-29 15:09:09 +08:00
# Converted by: chance
# Category: 去广告
# Source: https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Loon/RuCu6/youtube.lpx
# Target: Surge

# Source [Argument] (declaration-only conversion; typed/dynamic arguments stay Review):
# blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
# blockShorts=switch, false, true, tag=隐藏短片按钮, desc=用于隐藏YouTube Shorts按钮
# blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
# debug=switch, false, true, tag=启用调试模式, desc=此插件的调试模式
# captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, desc=需要把YouTube字幕翻译翻译为何种语言

[Rule]
#AND, ((DOMAIN, youtubei.googleapis.com), (PROTOCOL, UDP)), REJECT
#AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, UDP)), REJECT

[URL Rewrite]
# loon 专用写法
#response if ${url} ~= /^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\?/i then response.body.mock("text", "", 200)
# youtube 短链移除追踪参数
(^https:\/\/youtu\.be\/[\w-]+)(?:\?si=\w+) $1 302

[Script]
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon typed/object $argument cannot be preserved as Surge string $argument without changing the script
# Source declaration: request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://rucu6.pages.dev/Scripts/youtube/request.js", {${captionLang}}) with tag="youtube_request_init", requires_body=true, binary_body_mode=true
youtube_request_log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,script-path=https://rucu6.pages.dev/Scripts/youtube/request.js,requires-body=true,max-size=-1,binary-body-mode=true
# [WayX] SCRIPT V2 REVIEW REQUIRED: Loon typed/object $argument cannot be preserved as Surge string $argument without changing the script
# Source declaration: response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(?:youtubei\/v1\/(?:browse|config|log_event|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$/i then script("https://rucu6.pages.dev/Scripts/youtube/response.js", {${blockImmersive}, ${blockShorts}, ${blockUpload}, ${debug}, ${captionLang}}) with tag="youtube_response", requires_body=true, binary_body_mode=true

[MITM]
hostname = %APPEND% rr*.googlevideo.com, youtu.be, youtubei.googleapis.com
