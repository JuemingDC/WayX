[Rule]
DOMAIN,ad.12306.cn,DIRECT,extended-matching

[Body Rewrite]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$ 'if type == "object" then del(.["materialsList"]) else . end | if type == "object" then del(.["advertParam"]) else . end'

[Script]

移除12306应用内广告 = type=http-request,pattern=^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$,script-path=https://kelee.one/Resource/JavaScript/12306/12306_remove_ads.js

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn
