#!name=YouTube
#!desc=移除广告, 移除上传&短片按钮, 解锁播放速度&精彩跳转。
#!category=WayX
#!requirement=CORE_VERSION>=22
#!arguments=autoHd:false,blockAi:false,blockGames:false,blockShorts:false,blockStore:false,blockUpload:false,blockVerticalLive:false,jumpAhead:false,onTheGo:false
#!arguments-desc=autoHd: 自动最高画质 — true/false — 自动选择 YouTube 最高画质\nblockAi: 隐藏智能助手 — true/false — 用于隐藏 YouTube 智能助手\nblockGames: 隐藏内置游戏 — true/false — 用于隐藏 YouTube 游戏服务\nblockShorts: 隐藏短片按钮 — true/false — 用于隐藏 YouTube 短片按钮\nblockStore: 隐藏商品橱窗 — true/false — 用于隐藏视频下方以及 YouTuber 主页中的商品推广\nblockUpload: 隐藏上传按钮 — true/false — 用于隐藏 YouTube 上传按钮\nblockVerticalLive: 隐藏竖屏直播 — true/false — 用于隐藏 YouTube 主页中的竖屏直播\njumpAhead: 开启精彩跳转 — true/false — 解锁 YouTube Premium Jump Ahead 按钮\nonTheGo: 开启通勤模式 — true/false — 解锁 YouTube Premium On-the-go 模式

# Author: Maasea[https://github.com/Maasea/sgmodule], gholts[https://github.com/gholts/surge], RuCu6[https://github.com/RuCu6]
# Icon: https://rucu6.pages.dev/Icons/app/youtube.png
# Updated: 2026-10-22 20:55

# Converted: 2026-11-01 23:22:46 +08:00
# Converted by: chance
# Source: https://rucu6.pages.dev/Plugins/youtube_gholts.lpx
# Target: Surge

[URL Rewrite]
(?i)^https:\/\/s\.youtube\.com\/api\/stats\/ads _ reject
(?i)^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ _ reject

[Script]
youtube_ad-break = type=http-request,pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/0b8b47c8cd9841e2029a314dc44e27fb7918541d2f71b501e659cddd3b091124/request_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20
youtube_init = type=http-request,pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/0b8b47c8cd9841e2029a314dc44e27fb7918541d2f71b501e659cddd3b091124/request_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20
#!REQUIREMENT "'{{{autoHd}}}'=='true'" youtube_auto-hd = type=http-request,pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$,script-path=https://rucu6.pages.dev/Scripts/youtube/request_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20,argument="{\"autoHd\":{{{autoHd}}}}"
youtube_log-event = type=http-request,pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/0b8b47c8cd9841e2029a314dc44e27fb7918541d2f71b501e659cddd3b091124/request_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20
youtube_response = type=http-response,pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9c6f6b0f1d9d5fa8ab88ce1ee561d4fd4f25f1b234adc11e97613806eb3fbebc/response_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20,argument="{\"autoHd\":{{{autoHd}}},\"blockAi\":{{{blockAi}}},\"blockGames\":{{{blockGames}}},\"blockShorts\":{{{blockShorts}}},\"blockStore\":{{{blockStore}}},\"blockUpload\":{{{blockUpload}}},\"blockVerticalLive\":{{{blockVerticalLive}}},\"jumpAhead\":{{{jumpAhead}}},\"onTheGo\":{{{onTheGo}}}}"
youtube_key = type=http-response,pattern=(?i)^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/50fa8c762b1397a5774495e7b15dc311f4892dd6e4de1b2f4201cd4b640bf86e/key_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20
youtube_ump = type=http-response,pattern=(?i)^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/34e7811759469267add028ad0027db93749f300aae286630b43dae441adbd2b0/ump_gholts.js,requires-body=true,max-size=-1,binary-body-mode=true,timeout=20,argument="{\"autoHd\":{{{autoHd}}},\"blockAi\":{{{blockAi}}},\"blockGames\":{{{blockGames}}},\"blockStore\":{{{blockStore}}},\"blockVerticalLive\":{{{blockVerticalLive}}},\"jumpAhead\":{{{jumpAhead}}},\"onTheGo\":{{{onTheGo}}}}"

[MITM]
hostname = %APPEND% rr*.googlevideo.com, s.youtube.com, www.youtube.com, youtubei.googleapis.com
