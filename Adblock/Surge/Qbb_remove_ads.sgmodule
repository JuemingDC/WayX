#!name=亲宝宝去广告
#!desc=移除开屏广告、弹窗广告、广告下发、用户行为上报，精简搜索页、育儿页和我的页面，拦截商城页面。
#!category=WayX
#!requirement=CORE_VERSION>=20

# Open URL: https://apps.apple.com/app/id672984826
# Author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Tags: 去广告
# Homepage: https://hub.kelee.one
# Icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Qbb.png
# Updated: 2026-10-02 13:57:49

# Converted: 2026-10-03 17:45:05 +08:00
# Converted by: chance
# Source: https://kelee.one/Tool/Loon/Lpx/Qbb_remove_ads.lpx
# Target: Surge

[Rule]
DOMAIN,apimall.qbb6.com,REJECT

[Map Local]
^https:\/\/api\.qbb6\.com\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.qbb6\.com\/commons\/main\/tab\/info\/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/apicommunity\.qbb6\.com\/community\/recommend\/user\/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/apipt\.qbb6\.com\/parenting\/pt\/home\/post\/card\/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/apipt\.qbb6\.com\/lib\/search\/hot\/keys\/v\d\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/apiuser\.qbb6\.com\/user\/member\/info\/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/apimall\.qbb6\.com\/mall\/v\d\/goods\/count\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/apimall\.qbb6\.com\/mall\/homepage\/data\/get\/v\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
精简我的页面 = type=http-response,pattern=^https:\/\/api\.qbb6\.com\/commons\/self\/button\/group\/get\/v\d\?,script-path=https://kelee.one/Resource/JavaScript/Qbb/my.js,requires-body=true,max-size=-1

精简育儿页面 = type=http-response,pattern=^https:\/\/apipt\.qbb6\.com\/parenting\/pt\/homepage\/get\/v\d\?,script-path=https://kelee.one/Resource/JavaScript/Qbb/homepage.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% api.qbb6.com, apicommunity.qbb6.com, apipt.qbb6.com, apiuser.qbb6.com, apimall.qbb6.com
