[Body Rewrite]

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.bevol\.com\/appmain\/app\/home\/page$ '(. as $__wayx_before | try (if type == "object" then del(.["result"]["versionPopUp"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["isShowSearchLabel"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["isShowSearchFeedBack"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["centerBannerAdvert"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["programmaticAdvertising"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["mattsData"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["questionnaireMap"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["appPullDownAdvert"]) else . end) catch $__wayx_before)'

http-response-jq ^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ 'del(.result.banners)'
http-response-jq ^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.bevol\.com\/trialbox\/shop\/app\/homePage$ '(. as $__wayx_before | try (if type == "object" then del(.["result"]["firstPersonActivity"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["mainActivity"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["brandZone"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["imageAD2"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["result"]["couponPopupInfo"]) else . end) catch $__wayx_before)'

