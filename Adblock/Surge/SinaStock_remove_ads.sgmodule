[Body Rewrite]
http-response-jq ^https:\/\/news\.cj\.sina\.cn\/app\/v1\/news724\/list\? 'delpaths([["result","data","ad"]])'

http-response-jq ^https:\/\/app\.cj\.sina\.com\.cn\/apps\/api\/user\/center\? '.result.data |= with_entries(select(.key == "button" or .key == "account" or .key == "balance"))'

http-response-jq ^https:\/\/news\.cj\.sina\.cn\/toutiao\/content\? 'del(.result.data[]?.ad, .result.data[]?.report)'

http-response-jq ^https:\/\/app\.cj\.sina\.com\.cn\/api\/deal\/index\? 'delpaths([["data","banner"]])'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/app\.cj\.sina\.com\.cn\/clientSetting\/api\/start\/init\? 'delpaths([["result","data","search_ad"],["result","data","center_ads"],["result","data","banner_new_tagid"],["result","data","ad_hasAddScreenParam"],["result","data","us_trade"],["result","data","open_account"],["result","data","us_hq_trade"]])'

http-response-jq ^https:\/\/(newscj\.xincai\.com|news\.cj\.sina\.cn)\/app\/v1\/feed\? '.data.feed.data |= map(select((.author // "") != ""))'

[Map Local]

^https:\/\/news\.cj\.sina\.cn\/search\/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/search\.cj\.sina\.cn\/stock\/get_index_new\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/news\.cj\.sina\.cn\/search\/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/recommend\.cj\.sina\.cn\/app\/v2\/search\/discovery$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/quotes\.sina\.com\.cn\/cn\/api\/openapi\.php\/PriceChangeService\.getSearchList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.cj.sina.com.cn, news.cj.sina.cn, search.cj.sina.cn, recommend.cj.sina.cn, quotes.sina.com.cn, newscj.xincai.com
