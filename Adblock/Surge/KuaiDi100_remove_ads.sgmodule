[Body Rewrite]
http-response-jq ^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$ 'del(.adsplash, .adIsConsumable, .adProductId, .nologin_tips, .index_banner, .me_banner, .index_banner_shadow, .adshongbao, .adsapp_homepage_ticket_pop, .adsoptimizationsend, .adsapp_activity_ad_array, .adbanner, .adposition, .adShowAgainTime)'

http-response-jq ^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox 'del(.data.secondMenuList)'

[Map Local]

^https?:\/\/p\.kuaidi100\.com\/advertisement\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% p.kuaidi100.com
