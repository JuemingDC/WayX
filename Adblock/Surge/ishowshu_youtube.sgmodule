#!name=Youtube
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: Youtube
# Updated: 2026-10-25 19:01:27 +08:00
# Merged by: chance
# Source Authors: 树先生, Maasea
# Category: app
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/youtube.snippet
# Upstream name = Youtube
# Upstream author = Maasea
# Upstream desc = 移除广告
#^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad url reject-dict
#^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* url script-request-body https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js
#^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch) url script-response-body https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js
# //  信息流
# //  搜索页结果
# //  首页顶部导航菜单、软件dock菜单栏，(导航会误杀
#^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/guide url script-response-body https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js
# //  获取配置
# //  播放页
# //  短视频
# Upstream hostname = *.googlevideo.com, youtubei.googleapis.com

[Map Local]
^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ishowshu_youtube_1 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_2 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/search,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_3 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/account\/get_setting,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_4 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_5 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/next,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_6 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\?,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true
ishowshu_youtube_7 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/reel\/reel_watch_sequence,script-path=https://github.com/Maasea/sgmodule/raw/refs/heads/master/Script/Youtube/youtube.response.js,requires-body=true

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
