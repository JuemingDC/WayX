# Source: https://rucu6.pages.dev/Plugins/jingdong.lpx

[Rule]
AND,((DOMAIN,api.m.jd.com,extended-matching),(PROTOCOL,TCP)),REJECT-NO-DROP

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig 'setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0) | setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0) | setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=cart 'del(.cartLocationMap.loc_emptyCartFloor2,.emptyCartRecommendFloor)'

[Map Local]
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
#!REQUIREMENT "'{{{Capture}}}'=='true'" manmanbuy_cookies = type=http-request,pattern=(?i)^https:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/RuCu6/JingDong/manmanbuy_ck.js,requires-body=true
jingdong_noad = type=http-response,pattern=(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/RuCu6/JingDong/jingdong.js,requires-body=true
jd_price = type=http-response,pattern=(?i)^https:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/RuCu6/JingDong/jd_price.js,requires-body=true,argument="{\"Cookies\":\"{{{Cookies}}}\"}"

[MITM]
hostname = %APPEND% apapia-sqk-weblogic.manmanbuy.com, api.m.jd.com, in.m.jd.com
