[Rule]
URL-REGEX,^https:\/\/(ask|cgate)\.zhaopin\.com\/operation\/ad\/,REJECT,extended-matching

[URL Rewrite]

^https:\/\/cgate\.zhaopin\.com\/bdp\/commercial\/queryLinkData$ _ reject

[Map Local]

^https:\/\/cgate\.zhaopin\.com\/resumeapi\/resumeCheck\/positionDetailBottomTipCheck$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
wayx_features_0a96abbaad = type=http-response,pattern=^,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Kelee_ZhiLianZhaoPin_remove_ads/features_surge_0a96abbaad.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% ask.zhaopin.com, cgate.zhaopin.com
