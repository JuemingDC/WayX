[Body Rewrite]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.cece\.com\/user\/init\? 'delpaths([["data","launch_img_url"],["data","launch_goto_url"]])'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/app_config\? 'setpath(["data","is_new_year"]; false) | setpath(["data","spring_festival"]; false) | setpath(["data","show_feedback_entry"]; false) | setpath(["data","show_course_entry"]; false) | setpath(["data","show_store_entry"]; false) | setpath(["data","show_luna"]; false) | setpath(["data","show_ead"]; false) | setpath(["data","show_ad"]; false) | setpath(["data","show_live_filter_tarot"]; false) | setpath(["data","community_feed_adswitch"]; false) | setpath(["data","open_screen_ad_times"]; 0) | setpath(["data","open_screen_ad_duration"]; 0) | setpath(["data","isShowThumbsGif"]; false) | setpath(["data","teenager_mode_open"]; false) | setpath(["data","flu_log"]; false)'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/app_config\? 'delpaths([["data","activity_list"],["data","fortune_ab_config"]])'

http-response-jq ^https:\/\/api\.cece\.com\/chart\/tools\/home_10_tools\? '.data.tools |= map(del(.icon_tip_image))'

http-response-jq ^https:\/\/api\.cece\.com\/user\/index\/tab_list\? '.data.tabs |= map(select(.type != "shop"))'

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/risk_entrance\? 'setpath(["data","ai_fortune_show_ask_tool"]; false) | setpath(["data","ai_sign_show_ask_tool"]; false) | setpath(["data","single_tool_show_dice_card"]; false) | setpath(["data","single_tool_show_tarot_card"]; false) | setpath(["data","single_tool_show_bazi_card"]; false) | setpath(["data","single_tool_show_hepan_card"]; false) | setpath(["data","single_tool_show_ziwei_card"]; false) | setpath(["data","single_tool_show_xingpan_card"]; false) | setpath(["data","multi_tool_show_card"]; false) | setpath(["data","ai_ccai_show_multi_tool"]; false)'

