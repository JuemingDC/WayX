# Upstream date=undefined
#############################################
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-img-al.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
# 惊喜弹窗
# 信息流
# 搜索页
# 开屏广告
# 详情页,小部件
#^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/user\/followings\/followfeed url script-response-body https://github.com/fmz200/wool_scripts/raw/main/Scripts/xiaohongshu/xiaohongshu.js
#^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/recommend\/user\/follow_recommend\? url script-response-body https://github.com/fmz200/wool_scripts/raw/main/Scripts/xiaohongshu/xiaohongshu.js
# 图片水印,视频水印
# 评论区用户id置空 (实验功能可能无效)
# 评论区图片水印 (实验功能可能无效)

[Map Local]
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/surprisebox\/(get_style|open|submit_action) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/guide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/guide\/user_banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/www\.(xiaohongshu|rnote)\.com\/api\/sns\/(v\d+\/ads\/resource|v\d+\/hey\/\w+\/hey_gallery) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/ci\.(xiaohongshu|rnote)\.com\/system_config\/watermark data-type=tiny-gif status-code=200

[Body Rewrite]
http-response ^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d\/note\/comment\/list red_id fmz200

[Script]
fmz200_xiaohongshu_1 = type=http-response,pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/(banner_list|hot_list),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_2 = type=http-response,pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/(hint|trending)\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_3 = type=http-response,pattern=^https?:\/\/(so|edith)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/search\/notes\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_4 = type=http-response,pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/config\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_5 = type=http-response,pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/system_service\/splash_config,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_6 = type=http-response,pattern=^https?:\/\/edith\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/widgets,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_7 = type=http-response,pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/note\/(imagefeed|live_photo\/save),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_8 = type=http-response,pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(followfeed|homefeed)\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_9 = type=http-response,pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v2\/note\/feed|v3\/note\/videofeed)\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true
fmz200_xiaohongshu_10 = type=http-response,pattern=^https?:\/\/(edith|rec|www)\.(xiaohongshu|rnote)\.com\/api\/sns\/(v4\/note\/videofeed|v10\/note\/video\/save)\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/9f5ee26c8a7e012dee5b993dccd77e876aa7e9413833c2bf09d3f6a29800f552/xiaohongshu.js,requires-body=true

