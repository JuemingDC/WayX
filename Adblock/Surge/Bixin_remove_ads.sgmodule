[URL Rewrite]
^https:\/\/web\.hibixin\.com\/user-recall\/signModal$ _ reject

^https:\/\/web-bxyuer\.bixin\.cn\/yuer-ads\? _ reject

[Body Rewrite]

http-response-jq ^https:\/\/api\.hibixin\.com\/biggie\/home\/v\d\/query\/biggie$ '.result.list |= map(select(has("bannerList") and .bannerList == null))'

http-response-jq ^https:\/\/api\.hibixin\.com\/resource\/v\d\/common\/tab$ '.result |= map(select(.type != "activityCenter"))'

[Map Local]

^https:\/\/api\.hibixin\.com\/config\/v\d\/common\/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/rec\/card\/query$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.hibixin\.com\/msg\/user\/friends\/trends\/top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.xxqapp\.cn\/live\/pendant\/index\/items$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.xxqapp\.cn\/banner\/list\/\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.hibixin\.com\/content\/v\d\/home\/page\/list$ data-type=text data="{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.hibixin\.com\/resource\/v\d\/discovery\/entrance\/activity$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.hibixin\.com\/config\/search\/qryConfigPart$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.xxqapp\.cn\/live\/flow\/pendant\/meta$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/gateway\.bxyuer\.com\/official\/room\/tab\/pop$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/gateway\.xxqapp\.cn\/living\/room\/fetch\/recommend-follow-list$ data-type=text data="{\"code\":\"8000\",\"msg\":\"SUCCESS\",\"success\":true}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.hibixin\.com\/biggie\/query\/skill\/detail\/relateRecommendBiggieV\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
精简首页标签 = type=http-response,pattern=^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/common\/tab\/query$,script-path=https://kelee.one/Resource/JavaScript/Bixin/common_tab.js,requires-body=true,max-size=-1,timeout=20

精简我的页面 = type=http-response,pattern=^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/my\/page$,script-path=https://kelee.one/Resource/JavaScript/Bixin/my_page.js,requires-body=true,max-size=-1,timeout=20

[MITM]
hostname = %APPEND% web.hibixin.com, api.hibixin.com, gateway.hibixin.com, gateway.xxqapp.cn, api.xxqapp.cn, web-bxyuer.bixin.cn, gateway.bxyuer.com
