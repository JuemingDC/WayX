[Rule]
DOMAIN,ad.jia.360.cn,REJECT,extended-matching,pre-matching
DOMAIN,ad.iot.360.cn,REJECT,extended-matching,pre-matching

[Body Rewrite]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/jia\.360\.cn\/conf\/v1\.json 'if type == "object" then delpaths([["tab_conf"]]) else . end | if type == "object" then delpaths([["ad_conf"]]) else . end | if type == "object" then delpaths([["activity"]]) else . end'

[MITM]
hostname = %APPEND% jia.360.cn
