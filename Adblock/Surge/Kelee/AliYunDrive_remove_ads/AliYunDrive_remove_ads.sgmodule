[Rule]
IP-CIDR,203.107.1.1/24,REJECT,no-resolve,pre-matching

[Map Local]
(?i)^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除阿里云盘广告 = type=http-response,pattern=(?i)^https:\/\/(biz)?api\.alipan\.com\/apps\/v\d\/users?\/home\/(news|widgets),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/Kelee/AliYunDrive_remove_ads/AliYunDrive_remove_ads.js,requires-body=true
移除阿里云盘广告-member-.alipan-.com-v1-users-onboard_list = type=http-response,pattern=(?i)^https:\/\/member\.alipan\.com\/v1\/users\/onboard_list,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/Kelee/AliYunDrive_remove_ads/AliYunDrive_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% api.alipan.com, member.alipan.com, bizapi.alipan.com
