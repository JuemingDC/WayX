[Rule]
# Name: YouTube 强制简体中文字幕
# Updated: 2026-10-25 19:01:30 +08:00
# Merged by: chance
# Source Authors: 怎么肥事, @ZenmoFeiShi
# Category: app
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/main/Yt-zh.snippet
# Upstream author=@ZenmoFeiShi
# Upstream name=YouTube 强制简体中文字幕
# Upstream hostname = www.youtube.com

[Script]
zenmofeishi_yt-zh_1 = type=http-request,pattern=^https://www\.youtube\.com/api/timedtext\?.*_ytzhsub=1,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/yt-sub-clean.js,requires-body=false
zenmofeishi_yt-zh_2 = type=http-response,pattern=^https://www\.youtube\.com/api/timedtext\?,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/yt-zh-sub.js,requires-body=true

[MITM]
hostname = %APPEND% www.youtube.com
