# Source: https://kelee.one/Tool/Loon/Lpx/XiaobaiPrint_remove_ads.lpx
# Target: Surge

[Rule]
DOMAIN,ad.lovefree.cc,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,adwanji.com,REJECT,extended-matching,pre-matching

[Body Rewrite]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/epbox\.gongfudou\.com\/graphql$ 'delpaths([["data","mallConsumables"],["data","currentUser","goodsCoupons"]])'

http-response-jq ^https:\/\/epbox\.gongfudou\.com\/graphql$ 'if .data.systemConfig.searchHotTags? then del(.data.systemConfig) else . end'

http-response-jq ^https:\/\/epbox\.gongfudou\.com\/graphql$ 'if (.data.page.__typename=="Page" and .data.page.name=="场景化改版 2024") then .data.page.firstTabDetail.floors|=map(select(.numType=="row")) else . end'

[Map Local]

^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/banners\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/epbox\.gongfudou\.com\/big_data\/v\d\/canvas\/query_actions\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% epbox.gongfudou.com, epbox.gongfudou.com
