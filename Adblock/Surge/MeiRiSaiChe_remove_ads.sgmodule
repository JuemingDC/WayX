[Body Rewrite]
http-response-jq ^https:\/\/api\.romielf\.com\/index\/indexv\d\? 'if getpath(["data","advertisement"]) then setpath(["data","advertisement"]; "[]") else . end | if getpath(["data","listadvertising"]) then setpath(["data","listadvertising"]; "[]") else . end'
http-response-jq ^https:\/\/api\.romielf\.com\/index\/indexv\d\? '.data.list |= map(select(.type == 1))'

[MITM]
hostname = %APPEND% api.romielf.com
