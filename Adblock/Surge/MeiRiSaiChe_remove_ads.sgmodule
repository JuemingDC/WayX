[Body Rewrite]
# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.romielf\.com\/index\/indexv\d\? 'if (getpath(["data"]) | has("advertisement")) then (setpath(["data","advertisement"]; "[]")) else . end | if (getpath(["data"]) | has("listadvertising")) then (setpath(["data","listadvertising"]; "[]")) else . end'
http-response-jq ^https:\/\/api\.romielf\.com\/index\/indexv\d\? '.data.list |= map(select(.type == 1))'

[MITM]
hostname = %APPEND% api.romielf.com
