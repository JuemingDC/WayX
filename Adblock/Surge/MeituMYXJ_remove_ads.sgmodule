# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? '(. as $__wayx_before | try (if type == "object" then if (try (getpath(["response","function_pop","meiyan_style"]) | has("is_pop")) catch false) then setpath(["response","function_pop","meiyan_style","is_pop"]; false) else . end else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then if (try (getpath(["response","onoff","vip_half_window_exit_remain_popup"]) | has("open")) catch false) then setpath(["response","onoff","vip_half_window_exit_remain_popup","open"]; 0) else . end else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then if (try (getpath(["response","onoff"]) | has("vip_home_exit_remain_popup")) catch false) then setpath(["response","onoff","vip_home_exit_remain_popup"]; 0) else . end else . end) catch $__wayx_before)'

