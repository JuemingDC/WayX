[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Body Rewrite]
http-response-jq ^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? 'del(.response.time_limit, .response.bubble, .response.person_center)'
http-response-jq ^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\? 'if getpath(["response","function_pop","meiyan_style","is_pop"]) then setpath(["response","function_pop","meiyan_style","is_pop"]; false) else . end | if getpath(["response","onoff","vip_half_window_exit_remain_popup","open"]) then setpath(["response","onoff","vip_half_window_exit_remain_popup","open"]; 0) else . end | if getpath(["response","onoff","vip_home_exit_remain_popup"]) then setpath(["response","onoff","vip_home_exit_remain_popup"]; 0) else . end'

[Map Local]
^https:\/\/api\.meiyan\.com\/operation\/home_banner\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.meiyan\.com\/vip\/permission_update_popup\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
精简首页功能栏目并移除美颜推荐 = type=http-response,pattern=^https:\/\/api\.meiyan\.com\/operation\/home\.json\?,script-path=https://kelee.one/Resource/JavaScript/MeituMYXJ/MeituMYXJ_remove_ads.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% api.meiyan.com
