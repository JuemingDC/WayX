[Script]
趣智校园净化 = type=http-response,pattern=^https:\/\/v3-api\.china-qzxy\.cn\/(?:user\/coin\/info\/withAppAdvChannel|project\/adv\/chain\/get|project\/advSpace\/app\/v2\/list|settlement\/advertise\/freeMeal\/activity\/index|project\/info\/triple|project\/iconSlogan)(?:\?|$),requires-body=true,max-size=262144,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/QZXY/Surge/QZXYCleaner.js

[MITM]
