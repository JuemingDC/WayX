[Body Rewrite]

# [WayX] COMPATIBILITY LIMITATION: native URL matcher retains source regex body; Loon flags i are not a verified target-engine equivalence.
http-response-jq ^https:\/\/appwk\.baidu\.com\/appapi\/index\/home\? '(. as $__wayx_before | try (if type == "object" then del(.["data"]["bannerInfo"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["bannerList"]) else . end) catch $__wayx_before) | (. as $__wayx_before | try (if type == "object" then del(.["data"]["bannerListV2"]) else . end) catch $__wayx_before)'

http-response-jq ^https:\/\/(appwk|tanbi)\.baidu\.com\/gsula\/sula\/syncmrecall$ 'del(.data.items)'

http-response-jq ^https:\/\/appwk\.baidu\.com\/appapi\/index\/tab\? 'del(.data)'

http-response-jq ^https:\/\/appwk\.baidu\.com\/appapi\/forum\/feed\?reqMode=wenkuapp_main_feed 'del(.data)'

