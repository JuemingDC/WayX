#!name=WebPage
#!desc=移除网页广告。
#!category=WayX
#!requirement=CORE_VERSION>=20
#!arguments=wayx_proxy_policy:DIRECT
#!arguments-desc=wayx_proxy_policy: Loon PROXY policy binding — default DIRECT; set to the desired Surge proxy policy or policy group

# Author: RuCu6[https://github.com/RuCu6]
# Icon: https://rucu6.pages.dev/Icons/app/webpage.png
# Updated: 2026-10-30 08:50

# Converted: 2026-10-30 14:21:09 +08:00
# Converted by: chance
# Source: https://rucu6.pages.dev/Plugins/webpage.lpx
# Target: Surge

[Rule]
# 黑料网
DOMAIN,18hlw.com,{{{wayx_proxy_policy}}},extended-matching
DOMAIN,8olbt.imsatcmn.cc,{{{wayx_proxy_policy}}},extended-matching
# 移花宫
DOMAIN,yhg007.com,{{{wayx_proxy_policy}}},extended-matching

[URL Rewrite]
# 解决 GitHub 速率限制返回429问题

# 桌面端请使用 https://google.com/ncr
# 谷歌服务重定向 //*.google.cn
^https?:\/\/(www\.)?(?:g|google)\.cn https://www.google.com 302
^https?:\/\/translate\.google\.cn https://translate.google.com 302

# Avple 跳转弹窗 //asserts.avple.tv
^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js _ reject

# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org
^https:\/\/exhentai\.org https://e-hentai.org 307

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$ $1 302
^https:\/\/www\.pornhub\.com\/ https://cn.pornhub.com/ 302

[Header Rewrite]
#request if ${url} ~= /^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
# http-request ^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\/ header-del Accept-Language
# http-request ^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\/ header-add Accept-Language en-us
#request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")
# http-request ^https:\/\/github\.com\/ header-del Accept-Language
# http-request ^https:\/\/github\.com\/ header-add Accept-Language en-us

# 可莉仓库解除 UA 限制 //kelee.one
http-request https:\/\/(rule\.)?kelee\.one\/ header-del user-agent
http-request https:\/\/(rule\.)?kelee\.one\/ header-add user-agent Loon/786 CFNetwork/1568.200.51 Darwin/24.1.0
http-response https:\/\/(rule\.)?kelee\.one\/ header-add content-disposition inline
http-response https:\/\/(rule\.)?kelee\.one\/ header-del content-type
http-response https:\/\/(rule\.)?kelee\.one\/ header-add content-type text/plain; charset=utf-8

[Map Local]
^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# ======= 普通网页 ======= #
# 百度 //boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com
baidu_boxer = type=http-request,pattern=^https:\/\/boxer\.baidu\.com\/scheme\?scheme,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/bbc2d768f38a841840d4729b5086ac803121a5730637f841316ba2f08c3e18a6/baiduNoRedirect.js,requires-body=true,max-size=-1,timeout=20
baidu_home = type=http-response,pattern=^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Api/loon-to-surge/0443d2b53d8bbb3c3c837e801b844b6efae811e26e423bbcbb7b6913e39cf551.js,requires-body=true,max-size=-1,timeout=20
baidu_zhidao = type=http-response,pattern=^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Api/loon-to-surge/c375b67cf3839ed20940676d4570db8ab99854ead1db638a5ef7c76848646ab3.js,requires-body=true,max-size=-1,timeout=20

# 观影 //www.hgeme.com, www.xn--wcv59z.com
guanying_web_ads = type=http-response,pattern=^https:\/\/www\.(?:hgeme|xn--wcv59z)\.com\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20

# 移花宫 //yhg007.com, *.111107?.xyz
yihuagong_hash_ad = type=http-response,pattern=^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/hash\/(?:[a-fA-F0-9]{40}|[A-Z2-7]{32})\.html,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20
yihuagong_search_ads = type=http-response,pattern=^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/search-[^\/]+\.html,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20

# ======= ooxx ======= #
# 黑料网 //18hlw.com, 8olbt.imsatcmn.cc
18hlw_web_ads = type=http-response,pattern=^https:\/\/(?:18hlw\.com|8olbt\.imsatcmn\.cc)\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20

# 什么值得冲 //javranking.cc
javrk_web_ads = type=http-response,pattern=^https:\/\/javranking\.cc\/(?:zh-hans|en)\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20

# 夜未央 //miniapp2.52ywy.com
52ywy_web_ads = type=http-response,pattern=^https:\/\/miniapp2\.52ywy\.com\/(?:ywyminiappbot\/(?:getLatest|getLatestAll|getCategoryVideos|getSearch|series|movies|tv|av|getbloger)|player\/getPlayer)(\?|$),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/24bc13763e144e10fa2864b8c0239419987b1d1adbe8cd3ed6abbf7624ca0b19/52ywy.js,requires-body=true,max-size=-1,timeout=20

# 字母圈 //*.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com
zmq_web_ads = type=http-response,pattern=^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/20f454d55c70ecb70ff6bfcf2b6a47583df9fd0fd6ce1e3e4b4a9ed7872b19d4/zimuquan.js,requires-body=true,max-size=-1,timeout=20

# E-Hentai //e-hentai.org
ehentai_web_ads = type=http-response,pattern=^https:\/\/e-hentai\.org\/g\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/0ff77e6a08bcc0a1faa6cdde63dec8da3c3c46cf097b6f1e9df778b111f37ec3/ehentai.js,requires-body=true,max-size=-1,timeout=20

# Hanime1 //hanime1.me
hanime_web_ads = type=http-response,pattern=^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load)),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/ceb4bbfde63b333edd46f20884f99c7dff7bdfd7ed5acbb49a8faebb76a9ec7d/hanime.js,requires-body=true,max-size=-1,timeout=20

# JavDB //javdb.com
javdb_web_ads = type=http-response,pattern=^https:\/\/javdb\.com\/(?!over18\?),script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/75448e274a792df0699e55ecce4f9bfb1056f54b9516d204087e1f61d46608e6/myblockads.js,requires-body=true,max-size=-1,timeout=20

# MissAV //missav.ai, missav.fans, missav.ws
missav_web_ads = type=http-response,pattern=^https:\/\/missav\.(?:ai|fans|ws)\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/a7046a06dbbcd6c256d12fb312ba8d1dbefe59159914473541c874869071d160/missav.js,requires-body=true,max-size=-1,timeout=20

# PornHub //*.pornhub.com
pornhub_web_ads = type=http-response,pattern=^https:\/\/cn\.pornhub\.com\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Script/Api/loon-to-surge/47d1ae3fc7f861165f61fa3572d3c039dcd0340679900df213150605b4ea2b37.js,requires-body=true,max-size=-1,timeout=20

[MITM]
hostname = %APPEND% *.google.cn, asserts.avple.tv, kelee.one, rule.kelee.one, e-hentai.org, exhentai.org, *.pornhub.com, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, www.hgeme.com, www.xn--wcv59z.com, yhg007.com, *.111107?.xyz, 18hlw.com, 8olbt.imsatcmn.cc, javranking.cc, miniapp2.52ywy.com, *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com, hanime1.me, javdb.com, missav.ai, missav.fans, missav.ws
