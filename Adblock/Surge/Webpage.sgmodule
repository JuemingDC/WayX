[Rule]
# [WayX] Source Loon plugin policy PROXY preserved without conversion; Surge Module cannot activate external policy names.
# Source declaration: DOMAIN-SUFFIX, mypikpak.com, PROXY
# [WayX] Source Loon plugin policy PROXY preserved without conversion; Surge Module cannot activate external policy names.
# Source declaration: DOMAIN, 18hlw.com, PROXY
# [WayX] Source Loon plugin policy PROXY preserved without conversion; Surge Module cannot activate external policy names.
# Source declaration: DOMAIN, 8olbt.imsatcmn.cc, PROXY
# [WayX] Source Loon plugin policy PROXY preserved without conversion; Surge Module cannot activate external policy names.
# Source declaration: DOMAIN, yhg007.com, PROXY

[URL Rewrite]
# 解决 GitHub 速率限制返回429问题

# 桌面端请使用 https://google.com/ncr
# 谷歌服务重定向 //*.google.cn
^https?:\/\/(www\.)?(?:g|google)\.cn https://www.google.com 302
^https?:\/\/translate\.google\.cn https://translate.google.com 302

# Avple 跳转弹窗 //asserts.avple.tv
^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js _ reject

# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org
^https:\/\/exhentai\.org https://e-hentai.org 307

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$ $1 302
^https:\/\/www\.pornhub\.com\/ https://cn.pornhub.com/ 302

[Header Rewrite]
#request if ${url} ~= /^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\//i then request.header.set("Accept-Language", "en-us")
# http-request ^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\/ header-del Accept-Language
# http-request ^https:\/\/(?:avatars|gist|raw)\.githubusercontent\.com\/ header-add Accept-Language en-us
#request if ${url} ~= /^https:\/\/github\.com\//i then request.header.set("Accept-Language", "en-us")
# http-request ^https:\/\/github\.com\/ header-del Accept-Language
# http-request ^https:\/\/github\.com\/ header-add Accept-Language en-us

# 可莉仓库解除 UA 限制 //kelee.one
http-request https:\/\/(rule\.)?kelee\.one\/ header-del user-agent
http-request https:\/\/(rule\.)?kelee\.one\/ header-add user-agent Loon/786 CFNetwork/1568.200.51 Darwin/24.1.0
http-response https:\/\/(rule\.)?kelee\.one\/ header-add content-disposition inline
http-response https:\/\/(rule\.)?kelee\.one\/ header-del content-type
http-response https:\/\/(rule\.)?kelee\.one\/ header-add content-type text/plain; charset=utf-8

[Map Local]
^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# ======= 普通网页 ======= #
# 百度 //boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com
baidu_boxer = type=http-request,pattern=^https:\/\/boxer\.baidu\.com\/scheme\?scheme,script-path=https://rucu6.pages.dev/Scripts/baidu/baiduNoRedirect.js,requires-body=true,max-size=-1
baidu_home = type=http-response,pattern=^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$,script-path=https://rucu6.pages.dev/Scripts/webpage/baidu-index.js,requires-body=true,max-size=-1
baidu_zhidao = type=http-response,pattern=^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word),script-path=https://rucu6.pages.dev/Scripts/webpage/baidu-zhidao.js,requires-body=true,max-size=-1

# 观影 //www.hgeme.com, www.xn--wcv59z.com
guanying_web_ads = type=http-response,pattern=^https:\/\/www\.(?:hgeme|xn--wcv59z)\.com\/,script-path=https://rucu6.pages.dev/Scripts/webpage/myblockads.js,requires-body=true,max-size=-1

# 移花宫 //yhg007.com, *.111107?.xyz
yihuagong_hash_ad = type=http-response,pattern=^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/hash\/(?:[a-fA-F0-9]{40}|[A-Z2-7]{32})\.html$,script-path=https://rucu6.pages.dev/Scripts/webpage/myblockads.js,requires-body=true,max-size=-1
yihuagong_search_ads = type=http-response,pattern=^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/search-[^\/]+\.html$,script-path=https://rucu6.pages.dev/Scripts/webpage/myblockads.js,requires-body=true,max-size=-1

# ======= ooxx ======= #
# 黑料网 //18hlw.com, 8olbt.imsatcmn.cc
18hlw_web_ads = type=http-response,pattern=^https:\/\/(?:18hlw\.com|8olbt\.imsatcmn\.cc)\/,script-path=https://rucu6.pages.dev/Scripts/webpage/myblockads.js,requires-body=true,max-size=-1

# 夜未央 //miniapp2.52ywy.com
52ywy_web_ads = type=http-response,pattern=^https:\/\/miniapp2\.52ywy\.com\/(?:ywyminiappbot\/(?:getLatest|getLatestAll|getCategoryVideos|getSearch|series|movies|tv|av|getbloger)|player\/getPlayer)(\?|$),script-path=https://rucu6.pages.dev/Scripts/webpage/52ywy.js,requires-body=true,max-size=-1

# 字母圈 //*.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com
zmq_web_ads = type=http-response,pattern=^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\/,script-path=https://rucu6.pages.dev/Scripts/webpage/zimuquan.js,requires-body=true,max-size=-1

# E-Hentai //e-hentai.org
ehentai_web_ads = type=http-response,pattern=^https:\/\/e-hentai\.org\/g\/,script-path=https://rucu6.pages.dev/Scripts/webpage/ehentai.js,requires-body=true,max-size=-1

# Hanime1 //hanime1.me
hanime_web_ads = type=http-response,pattern=^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load)),script-path=https://rucu6.pages.dev/Scripts/webpage/hanime.js,requires-body=true,max-size=-1

# JavDB //javdb.com
javdb_web_ads = type=http-response,pattern=^https:\/\/javdb\.com\/(?!over18\?),script-path=https://rucu6.pages.dev/Scripts/webpage/myblockads.js,requires-body=true,max-size=-1

# MissAV //missav.ai, missav.fans, missav.ws
missav_web_ads = type=http-response,pattern=^https:\/\/missav\.(?:ai|fans|ws)\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/).,script-path=https://rucu6.pages.dev/Scripts/webpage/missav.js,requires-body=true,max-size=-1

# PornHub //*.pornhub.com
pornhub_web_ads = type=http-response,pattern=^https:\/\/cn\.pornhub\.com\/,script-path=https://rucu6.pages.dev/Scripts/webpage/pornhub.js,requires-body=true,max-size=-1

[MITM]
hostname = %APPEND% *.google.cn, asserts.avple.tv, kelee.one, rule.kelee.one, e-hentai.org, exhentai.org, *.pornhub.com, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, www.hgeme.com, www.xn--wcv59z.com, yhg007.com, *.111107?.xyz, 18hlw.com, 8olbt.imsatcmn.cc, miniapp2.52ywy.com, *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com, hanime1.me, javdb.com, missav.ai, missav.fans, missav.ws
