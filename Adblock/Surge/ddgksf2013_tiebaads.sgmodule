#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: 百度贴吧净化[墨鱼版]
# Updated: 2026-11-01 21:23:26 +08:00
# Copied by: chance
# Source Authors: 墨鱼 / ddgksf2013
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/TieBaAds.conf
// ==UserScript==
// @ScriptName        百度贴吧净化[墨鱼版]
// @Author            @app2smile, @ddgksf2013
// @Attention         QX(Build ≥ 848, Version > 1.5.2)
// @WechatID          墨鱼手记
// @TgChannel         https://t.me/ddgksf2021
// @Contribute        https://t.me/ddgksf2013_bot
// @UpdateTime        2025-05-13
// @Suitable          自行观看“# > ”注释内容
// @Attention         如需引用请注明出处，谢谢合作！
// @Version           V1.0.03
// @RewriteURL        https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/TieBaAds.conf
// ==/UserScript==
# Source declaration: IP-CIDR,180.76.76.200/32,reject
IP-CIDR,180.76.76.200/32,REJECT,no-resolve
# > 首页搜索|进吧搜索@ddgksf2013
# > 侧边抽屉栏@ddgksf2013
# > 我的页面@ddgksf2013
# > 进吧Form@ddgksf2013
# > 搜索推荐@@ddgksf2013
# > 页面中部广告@ddgksf2013
# > 贴吧proto处理@app2smile

[Map Local]
^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/ad\/getFeedAd data-type=text data="" status-code=200

[Body Rewrite]
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/search\/discover '.data.discover_list = []'
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/sidebar\/home 'del(.game_center, .tools, .vip_banner, .task_list)'
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/u\/user\/profile 'del(.duxiaoman, .namoaixud, .namoaixud_entry, .recom_naws_list, .duxiaoman_entry, .vip_banner) | .zone_info |= map(select(.type == "common_func" or .type == "auxiliary_func"))'
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/forum\/forumGuide '.hot_search = []'
http-response-jq ^https?:\/\/tieba(c)?\.baidu\.com\/mo\/q\/search\/startPage 'del(.data)'

[Script]
ddgksf2013_tiebaads_1 = type=http-response,pattern=^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/f\/(frs\/(page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Resource/Backup/script/f38021eb462fc211f4f2a268377861af099b43fbfb4eb694b9db532b5376b213/tieba-proto.js,requires-body=true

[MITM]
hostname = %APPEND% tieba.baidu.com, tiebac.baidu.com
