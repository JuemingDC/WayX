[URL Rewrite]
# 爱思助手 //list-app-m.i4.cn
^[hH][tT][tT][pP][sS]:\/\/[lL][iI][sS][tT]-[aA][pP][pP]-[mM]\.[iI]4\.[cC][nN]\/(?:[aA][dD][cC][lL][iI][cC][kK][cC][bB]|[gG][eE][tT][hH][oO][tT][sS][eE][aA][rR][cC][hH][lL][iI][sS][tT]|[gG][eE][tT][oO][pP][fF][sS][tT][aA][dD][iI][nN][fF][oO])\.[xX][hH][tT][mM][lL] _ reject

# 建设银行
^[hH][tT][tT][pP]:\/\/[iI][mM][aA][gG][eE]1\.[cC][cC][bB]\.[cC][oO][mM]\/[nN][eE][wW][sS][iI][nN][fF][oO]\/[eE][bB][rR][aA][nN][cC][hH]\/[cC][hH][eE][cC][kK]\/(?:[nN][fF]\/[nN][eE][wW][fF][iI][nN]\/[aA][cC][tT][iI][vV][iI][tT][yY]|[pP][oO]\/[pP][oO][oO][rR][tT][hH][eE][mM][eE]\/[aA][cC][tT][iI][vV][iI][tT][yY])\/\w+\.[pP][nN][gG] _ reject

# 云闪付 //wallet.95516.com
^[hH][tT][tT][pP][sS]:\/\/[wW][aA][lL][lL][eE][tT]\.95516\.[cC][oO][mM](:10533)?\/[sS]\/[wW][lL]\/[iI][cC][oO][nN]\/[lL][aA][rR][gG][eE]\/1 _ reject

[Body Rewrite]

# 昌原云充 五代十路 //www.washpayer.com
http-response-jq ^[hH][tT][tT][pP]:\/\/[aA][dD]\.5[tT][aA][oO]5[aA][iI]\.[cC][oO][mM]\/[cC][oO][mM][mM][oO][nN]\/[gG][eE][tT][rR][eE][cC][eE][iI][pP][tT]\? 'delpaths([["payload","adInfo"]])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[wW][wW][wW]\.[wW][aA][sS][hH][pP][aA][yY][eE][rR]\.[cC][oO][mM]\/[cC][oO][mM][mM][oO][nN]\/[gG][eE][tT][rR][eE][cC][eE][iI][pP][tT] 'delpaths([["payload","adInfo"]])'

# 墨迹天气 //mme.api.moji.com, sns.api.moji.com
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[mM][mM][eE]\.[aA][pP][iI]\.[mM][oO][jJ][iI]\.[cC][oO][mM]\/[jJ][sS][oO][nN]\/[eE][nN][tT][rR][aA][nN][cC][eE]\/[lL][iI][sS][tT]$ 'del(.entrance_region_res_list[] | select(.region_name == "皇冠区域" or .region_name == "banner区")) | .entrance_region_res_list[].entrance_res_list |= if . then map(select(.entrance_name | . != "墨迹钱包" and . != "墨圈")) else . end'

# Reddit //gql.reddit.com, gql-fed.reddit.com
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[gG][qQ][lL](-[fF][eE][dD])?\.[rR][eE][dD][dD][iI][tT]\.[cC][oO][mM] 'walk(if type=="object" then (if .isNsfw==true then .isNsfw=false else . end)|(if .isNsfwMediaBlocked==true then .isNsfwMediaBlocked=false else . end)|(if .isNsfwContentShown==false then .isNsfwContentShown=true else . end)|(if (.commentsPageAds|type=="array") then (.commentsPageAds=[]) else . end)|(if ((.node|type=="object") and (.node.cells|type=="array") and (.node.cells|any(.__typename?=="AdMetadataCell" or .isAdPost?==true))) then empty else . end)|(if (.node|type=="object") and (.node.adPayload|type=="object") then empty else . end)|(if .__typename=="AdPost" then empty else . end) else . end)'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[aA][pP][iI]\.[xX][iI][aA][cC][hH][uU][fF][aA][nN][gG]\.[cC][oO][mM]\/[vV]2\/[hH][oO][mM][eE][pP][aA][gG][eE]\/[pP][aA][gG][eE][dD]_[wW][aA][tT][eE][rR][fF][aA][lL][lL]_[rR][eE][cC][oO][mM][mM][eE][nN][dD][aA][tT][iI][oO][nN][sS]\.[jJ][sS][oO][nN] '.multiplex_cells |= map(select(.recommendation_cell.label != "广告"))'

# 小米商城 //api.m.mi.com, shop-api.retail.mi.com, xiaomishop.retail.mi.com
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[aA][pP][iI]\.[mM]\.[mM][iI]\.[cC][oO][mM]\/[vV]1\/[oO][rR][dD][eE][rR]\/[eE][xX][pP][rR][eE][sS][sS][vV][iI][eE][wW] 'delpaths([["data","bottom","ad_info"]])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[sS][hH][oO][pP]-[aA][pP][iI]\.[rR][eE][tT][aA][iI][lL]\.[mM][iI]\.[cC][oO][mM]\/[mM][tT][oO][pP]\/[aA][cC][tT]\/[mM][iI][sS][hH][oO][pP][sS][eE][aA][rR][cC][hH]\/[mM][aA][iI][nN][sS][eE][aA][rR][cC][hH] 'setpath(["data","recProductList"]; [])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[sS][hH][oO][pP]-[aA][pP][iI]\.[rR][eE][tT][aA][iI][lL]\.[mM][iI]\.[cC][oO][mM]\/[mM][tT][oO][pP]\/[mM][fF]\/[hH][oO][mM][eE]\/[vV]1\/[iI][nN][dD][eE][xX] 'delpaths([["data","floors",0,"data","left_icon_config"]]) | delpaths([["data","floors",0,"data","right_icon_config"]])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[sS][hH][oO][pP]-[aA][pP][iI]\.[rR][eE][tT][aA][iI][lL]\.[mM][iI]\.[cC][oO][mM]\/[mM][tT][oO][pP]\/[mM][fF]\/[uU][sS][eE][rR][cC][eE][nN][tT][eE][rR]\/[pP][eE][rR][sS][oO][nN][aA][lL][hH][oO][mM][eE] 'delpaths([["data","carouselAD"]])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[xX][iI][aA][oO][mM][iI][sS][hH][oO][pP]\.[rR][eE][tT][aA][iI][lL]\.[mM][iI]\.[cC][oO][mM]\/[mM][tT][oO][pP]\/[xX][iI][aA][oO][mM][iI][sS][hH][oO][pP]\/[pP][rR][oO][dD][uU][cC][tT]\/[iI][nN][fF][oO] 'delpaths([["data","carouselAdInfo"]]) | delpaths([["data","product","floatWindow"]])'
http-response-jq ^[hH][tT][tT][pP][sS]:\/\/[cC][oO][nN][fF]-[mM]-[sS][sS][lL]\.[xX][uU][nN][lL][eE][iI]\.[cC][oO][mM]\/[eE][xX][tT][eE][rR][nN][aA][lL]\/[0-9-a-zA-Z]+\? 'delpaths([["values","me_config","common_service_list"]])'

[Map Local]

