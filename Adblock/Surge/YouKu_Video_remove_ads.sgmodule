http-response-jq ^https:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\? 'del(.data.tipContent, .data.tipContentNew)'

[MITM]
hostname = %APPEND% push.m.youku.com, un-acs.youku.com
