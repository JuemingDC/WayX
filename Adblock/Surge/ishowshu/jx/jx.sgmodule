# Source declaration: ^https:\/\/hoapp\.juneyaoair\.com\/data\/index\/getPictureList url jsonjq-response-body if (.objData | any(.picLocation == "POSITION_POP_INDEX" or .picLocation == "POSITION_MY_ADD")) then .objData = [] else . end

[Map Local]
^https:\/\/hoapp\.juneyaoair\.com\/data\/index\/getLoadPic data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
