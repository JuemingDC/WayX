#!name=Spotify
# WayX ID: AD0403
# Icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/spotify.png
# Icon Collection: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/ligeicon.json
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: Spotify
# Updated: 上游未标注
# Copied by: chance
# Source Authors: 树先生
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/spotify.snippet
# Upstream name = Spotify
# Upstream desc = 移除广告,顺序听歌,仅支持新版本(旧版不兼容
# Upstream author = Auto-001(电报@SOLO灵魂), 001ProMax, 树先生

[URL Rewrite]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad 302

[Map Local]
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ishowshu_spotify_1 = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/spotify/spotify-qx.js,requires-body=true,binary-body-mode=true
ishowshu_spotify_2 = type=http-response,pattern=^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver\/v\d+\/configuration|nebula\/v\d+\/configuration\/attributes)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/spotify/spotify-qx.js,requires-body=true,binary-body-mode=true
ishowshu_spotify_3 = type=http-response,pattern=^https:\/\/(?:[\w-]+-)?spclient\.(?:wg\.)?spotify\.com(?::443)?\/browsita\/v1\/browse,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/spotify/spotify-browse.js,requires-body=true,binary-body-mode=true
ishowshu_spotify_4 = type=http-response,pattern=^https:\/\/(?:[\w-]+-)?spclient\.(?:wg\.)?spotify\.com(?::443)?\/scrollsita\/v1\/scroll\/,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/spotify/spotify-scroll.js,requires-body=true,binary-body-mode=true

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com
