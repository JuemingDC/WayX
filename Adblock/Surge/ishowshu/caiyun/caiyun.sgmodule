#!name=彩云天气Pro
# Icon: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/03CNSoft/caiyuntianqi.png
# Icon Collection: https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/ligeicon.json
#!desc=Native QX conversion
#!category=WayX
#!requirement=CORE_VERSION>=20
# Native QX review count: 0

[Rule]
# Name: 彩云天气Pro
# Updated: 上游未标注
# Copied by: chance
# Source Authors: 树先生
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/caiyun.snippet
# Upstream name = 彩云天气Pro
# Upstream desc = 简单屏蔽一些广告
# Upstream author = 树先生
DOMAIN,abyss.cyapi.cn,REJECT
DOMAIN,ad.cyapi.cn,REJECT
# 移除彩云广告

[Map Local]
^https:\/\/starplucker\.cyapi\.cn\/v3\/operation\/features data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ishowshu_caiyun_1 = type=http-response,pattern=^https:\/\/api\.caiyunapp\.com\/v1\/activity\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/caiyun/caiyun.js,requires-body=true
ishowshu_caiyun_2 = type=http-response,pattern=^https:\/\/wrapper\.cyapi\.cn\/v1\/activity\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/caiyun/caiyun.js,requires-body=true
ishowshu_caiyun_3 = type=http-response,pattern=^https:\/\/wrapper\.cyapi\.cn\/v1\/(nafp\/origin_images|satellite)\?,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ishowshu/caiyun/caiyun.js,requires-body=true

[MITM]
hostname = %APPEND% wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn
