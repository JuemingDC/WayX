[Rule]
# Name: Github
# Updated: 上游未标注
# Copied by: chance
# Source Authors: 树先生
# Category: Adblock
# Managed by: WayX Native QX
# Source: https://raw.githubusercontent.com/ishowshu/qx/main/rewrite/github.snippet
# Upstream name = Github
# Upstream desc = raw文件拉取
# Upstream author = 树先生

[Header Rewrite]
http-request ^https:\/\/(raw|gist)\.githubusercontent\.com\/ header-replace Accept-Language en-us
http-request ^https:\/\/github\.com\/ header-replace Accept-Language en-us

[MITM]
hostname = %APPEND% raw.githubusercontent.com, gist.githubusercontent.com, github.com
