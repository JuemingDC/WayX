http-response-jq ^https:\/\/chat-live\.soulapp\.cn\/chatroom\/getRoomTagInfo '.data.res |= map(.iconConfig = null)'

[Script]
ishowshu_soul_1 = type=http-response,pattern=^https:\/\/api-chat\.soulapp\.cn\/chat\/limitInfo,script-path=https://github.com/ishowshu/qx/raw/refs/heads/main/script/soul_qx.js,requires-body=true
