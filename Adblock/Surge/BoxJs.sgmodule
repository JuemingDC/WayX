[Rule]
DOMAIN-SUFFIX,jsdelivr.net,{{{wayx_proxy_policy}}}

[Script]
BoxJS = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js,requires-body=true,max-size=-1,timeout=120

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
