[Script]
wayx_qx_header_b93945a97d = type=http-response,pattern=^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,argument=wayx_qx_header_v1=%7B%22kind%22%3A%22field%22%2C%22field%22%3A%22User-Agent%22%2C%22pattern%22%3A%22%5E%5C%5Cs*QQSportsV3%5C%5C%2F%22%2C%22flags%22%3A%22i%22%7D
zenmofeishi_txsports-ad-clean_1 = type=http-response,pattern=^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_2 = type=http-response,pattern=^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_3 = type=http-response,pattern=^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_4 = type=http-response,pattern=^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_5 = type=http-response,pattern=^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_6 = type=http-response,pattern=^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true
zenmofeishi_txsports-ad-clean_7 = type=http-response,pattern=^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$,script-path=https://raw.githubusercontent.com/JuemingDC/WayX/main/Adblock/Surge/ZenmoFeiShi/txsports-ad-clean/txsports-ad-clean.js,requires-body=true,binary-body-mode=true

[MITM]
hostname = %APPEND% config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
